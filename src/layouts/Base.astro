---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** JSON-LD extra (ej: FAQPage) que se inyecta además del AccountingService */
  jsonLdExtra?: unknown;
}

const { title, description = SITE.description, jsonLdExtra } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: SITE.name,
  legalName: SITE.legalName,
  description: SITE.description,
  url: SITE.url,
  email: SITE.email,
  telephone: '+54 9 11 3511-6890',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Chacabuco 511 P.B.',
    addressLocality: 'San Isidro',
    addressRegion: 'Buenos Aires',
    postalCode: 'B1642',
    addressCountry: 'AR',
  },
  sameAs: [SITE.linkedin],
  priceRange: '$$',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline>
      // Va inline y arriba de todo: es lo único que no puede fallar en llegar.
      // El CSS oculta el contenido revelable sólo bajo html.js, así que si el bundle no
      // baja (red móvil cortada, chunk 404) la página se ve entera, sin animación.
      document.documentElement.classList.add('js');
      // Y si el bundle baja pero no alcanza a revelar en 2s, mostramos todo igual.
      // reveal.js prende 'reveal-on' apenas toma el control y desarma esta red.
      // El número es la perilla: más bajo = menos espera en el peor caso, pero se pierde la
      // animación de revelado más seguido en redes lentas. El contenido vale más que la animación.
      setTimeout(function () {
        var raiz = document.documentElement;
        if (!raiz.classList.contains('reveal-on')) raiz.classList.add('sin-reveal');
      }, 2000);
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#cd3333" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {jsonLdExtra && <script type="application/ld+json" set:html={JSON.stringify(jsonLdExtra)} />}
    <ClientRouter />
    {/* Vercel Web Analytics no está habilitado en el proyecto: el script devolvía un 404 de
        30 KB de HTML en cada carga, sin cachear. Para activarlo de verdad va por el adapter
        (webAnalytics: { enabled: true } en astro.config.mjs) + el toggle del panel de Vercel. */}
  </head>
  <body>
    <a
      href="#contenido"
      class="fixed left-3 top-3 z-[60] -translate-y-24 rounded-md bg-brand px-4 py-2 text-sm font-bold text-white transition-transform focus:translate-y-0"
    >
      Saltar al contenido
    </a>
    <div id="scroll-progress"></div>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <MobileActionBar />
    <script>
      import '../scripts/reveal.js';
    </script>
  </body>
</html>
