---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** JSON-LD extra (ej: FAQPage) que se inyecta además del AccountingService */
  jsonLdExtra?: unknown;
}

const { title, description = SITE.description, jsonLdExtra } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: SITE.name,
  legalName: SITE.legalName,
  description: SITE.description,
  url: SITE.url,
  email: SITE.email,
  telephone: '+54 9 11 3511-6890',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Chacabuco 511 P.B.',
    addressLocality: 'San Isidro',
    addressRegion: 'Buenos Aires',
    postalCode: 'B1642',
    addressCountry: 'AR',
  },
  sameAs: [SITE.linkedin],
  priceRange: '$$',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {jsonLdExtra && <script type="application/ld+json" set:html={JSON.stringify(jsonLdExtra)} />}
  </head>
  <body>
    <div id="scroll-progress"></div>
    <div id="bg-fx" aria-hidden="true"><span></span><span></span><span></span></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <MobileActionBar />
    <script>
      import '../scripts/reveal.js';
    </script>
  </body>
</html>
