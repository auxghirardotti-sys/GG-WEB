---
// Botón flotante de WhatsApp (solo desktop; en mobile manda MobileActionBar).
import { waLink } from '../data/site';
---

<a
  href={waLink}
  target="_blank"
  rel="noopener"
  aria-label="Escribinos por WhatsApp"
  id="wsp-float"
  class="group fixed bottom-6 right-6 z-40 hidden items-center gap-0 rounded-full bg-wsp py-3 pl-3 pr-3 text-white shadow-[0_12px_30px_-8px_rgba(37,211,102,0.6)] transition-all duration-300 hover:bg-wsp-dark lg:flex"
>
  <span class="relative flex h-8 w-8 items-center justify-center">
    <span class="wsp-ping absolute inline-flex h-full w-full rounded-full bg-white/40"></span>
    <svg class="relative h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Z" />
      <path d="M12.04 2C6.56 2 2.1 6.45 2.1 11.93c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.92 9.92 0 0 0 4.79 1.22h.01c5.47 0 9.93-4.45 9.93-9.93A9.86 9.86 0 0 0 12.04 2Zm0 18.16a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38 8.27 8.27 0 0 1 8.25-8.25 8.2 8.2 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.41 5.84 8.27 8.27 0 0 1-8.24 8.23Z" />
    </svg>
  </span>
  <span id="wsp-label" class="max-w-[12rem] overflow-hidden whitespace-nowrap pl-2 pr-1 text-sm font-bold transition-all duration-500">
    Escribinos por WhatsApp
  </span>
</a>

<style>
  .wsp-ping {
    animation: wsp-ping 2.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes wsp-ping {
    0% { transform: scale(1); opacity: 0.5; }
    70%, 100% { transform: scale(2); opacity: 0; }
  }
  #wsp-float.collapsed #wsp-label {
    max-width: 0;
    padding-left: 0;
    padding-right: 0;
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .wsp-ping { animation: none; }
    #wsp-label { transition: none; }
  }
</style>

<script>
  // El label se contrae a solo ícono pasados 4s.
  const float = document.getElementById('wsp-float');
  if (float && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.setTimeout(() => float.classList.add('collapsed'), 4000);
  }
</script>
