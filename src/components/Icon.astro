      <path d="m21 3 1 11h-2" />
      <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" />
      <path d="M3 4h8" />
    </>
  )}
  {name === 'calendar-check' && (
    <>
      <rect x="3.5" y="5.5" width="17" height="15" rx="2.5" />
