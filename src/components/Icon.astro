---
/**
 * Iconos de línea del sitio (motivos basados en la iconografía del sitio anterior,
 * redibujados como SVG para que se vean nítidos en cualquier pantalla).
 */
interface Props {
  name:
    | 'contable'
    | 'impositivo'
    | 'agropecuario'
    | 'sociedades'
    | 'outsourcing'
    | 'people'
    | 'shield'
    | 'team'
    | 'globe'
    | 'check'
    | 'chat'
    | 'clipboard'
    | 'doc'
    | 'handshake'
    | 'calendar-check'
    | 'question'
    | 'phone'
    | 'mail'
    | 'pin'
    | 'arrow'
    | 'factory'
    | 'code';
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'contable' && (
    <>
      <path d="M4 20h16" />
