      <path d="M9 10h.01M12 10h.01M15 10h.01M9 14h.01M12 14h.01M15 14h.01" />
    </>
  )}
  {name === 'outsourcing' && (
    <>
      <rect x="3" y="7.5" width="18" height="12.5" rx="1.6" />
      <path d="M8.5 7.5V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5" />
      <path d="M3 12.5h18" />
      <path d="M11.5 12h1" />
