  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'factory' && (
    <>
      <path d="M3 21h18" />
      <path d="M4 21V11l5 3.5V11l5 3.5V8l5 3v9" />
