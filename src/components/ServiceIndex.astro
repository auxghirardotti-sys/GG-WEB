---
// Cards de servicio con imagen temática (duotono rojo) + insignia de vidrio (glass) con el ícono.
import Icon from './Icon.astro';
import { SERVICES } from '../data/services';

interface Props {
  /** slug a excluir (cross-sell dentro de una página de servicio) */
  exclude?: string;
}
const { exclude } = Astro.props;
const items = SERVICES.filter((s) => s.slug !== exclude);
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
  {
    items.map((s) => (
      <a
        href={`/servicios/${s.slug}`}
        class="lift surface-card group flex flex-col overflow-hidden rounded-md hover:border-brand"
      >
        <div class="zoom-host relative h-28 sm:h-32">
          <img src={s.cardImage} alt="" aria-hidden="true" class="h-full w-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-tr from-brand/75 via-brand/30 to-ink/25 mix-blend-multiply"></div>
          <div class="absolute inset-0 bg-ink/10"></div>
          <span class="absolute -bottom-6 left-5 flex h-14 w-14 items-center justify-center rounded-md border border-white/60 bg-white/70 text-brand shadow-[0_8px_20px_-8px_rgba(20,20,20,0.4)] backdrop-blur-md transition-colors group-hover:bg-brand group-hover:text-white">
            <Icon name={s.icon} class="h-7 w-7" />
          </span>
        </div>
        <div class="flex flex-1 flex-col p-5 pt-9">
          <h3 class="font-display text-lg text-ink transition-colors group-hover:text-brand-ink" style="font-weight:700">
            {s.title}
          </h3>
          <p class="mt-1.5 flex-1 text-sm leading-relaxed text-body">{s.card}</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold uppercase tracking-[0.08em] text-brand-ink">
            Ver más
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
      </a>
    ))
  }
</div>
