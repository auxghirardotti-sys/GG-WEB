---
// Cards de servicio: imagen temática de fondo (todo el cuadro) + efecto glass (frost) encima.
// "Ver más" NO navega: despliega los ítems del servicio hacia abajo, en la misma página (<details> nativo).
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import { SERVICES } from '../data/services';
import { img } from '../data/images';

interface Props {
  /** slug a excluir (cross-sell dentro de una página de servicio) */
  exclude?: string;
}
const { exclude } = Astro.props;
const items = SERVICES.filter((s) => s.slug !== exclude);
// Bento solo en la home (sin exclude); en páginas de servicio queda grilla uniforme.
const bento = !exclude;
// El diseño "2 grandes + 3 chicas" solo cierra con 5 servicios; con otra cantidad
// (ej. 6) usamos col-span-2 parejo => grilla 3×2 prolija.
const featured = bento && items.length === 5;
---

{/* MOBILE: cuadros compactos estilo "¿Qué necesitás resolver?" (mismo patrón de chip).
    Tocar lleva a la página del servicio. En sm+ se ocultan y vuelven las cards grandes. */}
<div class="grid grid-cols-2 gap-2 sm:hidden" data-reveal-stagger>
  {
    items.map((s) => (
      <a
        href={`/servicios/${s.slug}`}
        class="flex min-h-[44px] items-center gap-2 rounded-xl border border-line bg-surface px-3 py-2.5 text-left text-[13px] font-semibold leading-snug text-ink transition-all hover:border-brand hover:bg-brand/5 active:scale-[0.98]"
      >
        <span class="shrink-0 text-brand"><Icon name={s.icon} class="h-4 w-4" /></span>
        <span>{s.nav}</span>
      </a>
    ))
  }
</div>

<div class="hidden sm:block" data-carousel>
  <div
    class:list={[
      'no-scrollbar flex snap-x snap-mandatory items-start gap-4 overflow-x-auto pb-3 sm:grid sm:grid-cols-2 sm:overflow-visible sm:pb-0',
      bento ? 'lg:grid-cols-6' : 'lg:grid-cols-3',
    ]}
    data-carousel-track
    data-reveal-stagger
  >
  {
    items.map((s, i) => {
      const big = featured && i < 2;
      return (
      <details
        class:list={[
          'service-card group lift relative block overflow-hidden rounded-2xl border border-line bg-surface hover:border-brand sm:rounded-md',
          'shrink-0 basis-[72%] snap-start sm:basis-auto sm:shrink',
          bento && (big ? 'lg:col-span-3' : 'lg:col-span-2'),
        ]}
      >
        <summary class="relative flex min-h-[190px] cursor-pointer list-none flex-col sm:min-h-[264px]">
          <Image
            src={img(s.cardImage)}
            alt=""
            aria-hidden="true"
            loading="lazy"
            widths={[400, 800]}
            sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
            format="webp"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-brand/10 mix-blend-multiply"></div>
          <div class="relative flex flex-1 flex-col p-4 backdrop-blur-[5px] sm:p-5">
            <div class="absolute inset-0 bg-gradient-to-t from-white/97 via-white/90 to-white/72"></div>
            <div class="relative flex h-full flex-col">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand text-white shadow-[0_8px_20px_-8px_rgba(205,51,51,0.7)] transition-colors group-hover:bg-brand-ink sm:h-12 sm:w-12 sm:rounded-md">
                <Icon name={s.icon} class="h-6 w-6 sm:h-7 sm:w-7" />
              </span>
              <h3 class="mt-3 font-display text-base text-ink transition-colors group-hover:text-brand-ink sm:mt-5 sm:text-lg" style="font-weight:700">
                {s.title}
              </h3>
              <p class="mt-1.5 text-[13px] leading-snug text-body sm:mt-2 sm:text-sm sm:leading-relaxed">{s.card}</p>
              <div class="flex-1"></div>
              <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.08em] text-brand-ink sm:mt-4 sm:text-sm">
                <span class="group-open:hidden">Ver más</span>
                <span class="hidden group-open:inline">Ver menos</span>
                <svg class="faq-chevron h-4 w-4 shrink-0 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </div>

          {/* Panel que sube SOBRE la card: no empuja el layout, la grilla queda intacta */}
          <div class="service-panel absolute inset-0 z-10 flex flex-col bg-white/95 p-4 backdrop-blur-md sm:p-5">
            <div class="flex items-start justify-between gap-3">
              <h4 class="font-display-sm text-[15px] leading-tight text-brand-ink">{s.itemsTitle}</h4>
              <span class="-mr-1 -mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-muted transition-colors group-hover:text-brand-ink" aria-hidden="true">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
              </span>
            </div>
            <ul class="no-scrollbar mt-3 min-h-0 flex-1 space-y-1.5 overflow-y-auto pr-1">
              {s.items.map((it) => (
                <li class="flex items-start gap-2 text-[13px] leading-snug text-body">
                  <svg class="mt-[3px] h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M8.4 12.4l2.4 2.4 4.7-5.1" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{it}</span>
                </li>
              ))}
            </ul>
            <a href={`/servicios/${s.slug}`} class="underline-grow mt-3 inline-block shrink-0 text-sm font-semibold text-brand-ink">
              Ver servicio completo →
            </a>
          </div>
        </summary>
      </details>
      );
    })
  }
  </div>
</div>
