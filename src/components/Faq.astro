---
// Acordeón sobrio de preguntas frecuentes. Usa <details> nativo (cero JS, accesible).
import Kicker from './Kicker.astro';
import { FAQ } from '../data/site';
---

<section id="faq" class="bg-paper scroll-mt-20">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:py-24">
    <div data-reveal>
      <Kicker text="Preguntas frecuentes" />
      <h2 class="mt-4 font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
        Lo que solés querer saber antes de escribirnos
      </h2>
    </div>

    <div class="mt-10 border-t border-line" data-reveal>
      {
        FAQ.map((item) => (
          <details class="group border-b border-line">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
              <span class="font-display text-lg text-ink sm:text-xl" style="font-weight:700">{item.q}</span>
              <svg
                class="h-5 w-5 shrink-0 text-brand transition-transform duration-300 group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p class="pb-6 pr-8 text-base leading-relaxed text-body">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
