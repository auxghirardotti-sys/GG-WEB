---
// Acordeón sobrio de preguntas frecuentes. Usa <details> nativo (cero JS, accesible).
import Kicker from './Kicker.astro';
import { FAQ } from '../data/site';
---

<section id="faq" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-9 sm:px-6 sm:py-12 lg:py-16">
    <div data-reveal>
      <h2 class="font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
        Preguntas frecuentes
      </h2>
    </div>

    <div class="mt-10 max-w-3xl border-t border-line" data-reveal>
      {
        FAQ.map((item) => (
          <details class="group border-b border-line">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
              <span class="font-display text-lg text-ink sm:text-xl" style="font-weight:700">{item.q}</span>
              <svg
                class="faq-chevron h-5 w-5 shrink-0 text-brand transition-transform duration-300"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="faq-answer">
              <div class="overflow-hidden">
                <p class="pb-6 pr-8 text-base leading-relaxed text-body">{item.a}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
