---
import Wordmark from './Wordmark.astro';
import { SERVICES } from '../data/services';
import { SITE, waLink } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="surface-ink grid-ink masthead-top relative overflow-hidden text-white/70">
  <span class="ring-deco" aria-hidden="true" style="width:240px;height:240px;border-width:26px;border-color:rgba(226,59,59,0.14);top:-70px;right:4%"></span>
  <span class="ring-deco" aria-hidden="true" style="width:96px;height:96px;border-width:14px;border-color:rgba(226,59,59,0.18);top:60px;right:16%"></span>
  <div class="relative z-10 mx-auto max-w-6xl px-4 pt-8 sm:px-6 sm:pt-14">
    <Wordmark class="text-3xl text-white sm:text-5xl" punto />
    <p class="mt-2.5 max-w-md text-[13px] leading-relaxed text-white/70 sm:mt-4 sm:text-sm">
      Estudio de contadores y abogados con más de 60 años de trayectoria. Soluciones tributarias,
      societarias y de auditoría, más allá de las funciones tradicionales de la profesión.
    </p>
  </div>

  <div class="relative z-10 mx-auto grid max-w-6xl gap-6 px-4 py-7 sm:gap-10 sm:px-6 sm:py-12 md:grid-cols-2 lg:grid-cols-4">
    {/* En celular cada columna es un acordeón (arranca cerrado, lo abre el usuario);
        en ≥640px el script las deja abiertas y el <summary> queda inerte: se ve igual que siempre. */}
    <details class="foot-col" open>
      <summary class="foot-col__head text-xs font-bold uppercase leading-4 tracking-[0.2em] text-brand-bright">
        <span>Servicios</span>
        <svg class="foot-col__chev h-4 w-4 shrink-0 text-brand-bright sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <nav aria-label="Servicios">
        <ul class="mt-3 space-y-2.5 sm:mt-4">
          {SERVICES.map((s) => (
            <li>
              <a href={`/servicios/${s.slug}`} class="text-sm transition-colors hover:text-white">{s.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>

    <details class="foot-col" open>
      <summary class="foot-col__head text-xs font-bold uppercase leading-4 tracking-[0.2em] text-brand-bright">
        <span>El estudio</span>
        <svg class="foot-col__chev h-4 w-4 shrink-0 text-brand-bright sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <nav aria-label="El estudio">
        <ul class="mt-3 space-y-2.5 sm:mt-4">
          <li><a href="/quienes-somos" class="text-sm transition-colors hover:text-white">Quiénes somos</a></li>
          <li><a href="/novedades" class="text-sm transition-colors hover:text-white">Novedades</a></li>
          <li><a href="/contacto" class="text-sm transition-colors hover:text-white">Contacto</a></li>
          <li>
            <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('CV - Buscamos talentos')}`} class="text-sm transition-colors hover:text-white">
              Buscamos talentos · Enviá tu CV
            </a>
          </li>
        </ul>
      </nav>
    </details>

    <details class="foot-col" open>
      <summary class="foot-col__head text-xs font-bold uppercase leading-4 tracking-[0.2em] text-brand-bright">
        <span>Contacto</span>
        <svg class="foot-col__chev h-4 w-4 shrink-0 text-brand-bright sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <ul class="mt-3 space-y-3 text-sm sm:mt-4">
        <li>
          <a href={SITE.mapsLink} target="_blank" rel="noopener" class="transition-colors hover:text-white">{SITE.addressFull}</a>
        </li>
        <li><a href={SITE.phoneHref} class="transition-colors hover:text-white">{SITE.phoneDisplay}</a></li>
        <li><a href={`mailto:${SITE.email}`} class="transition-colors hover:text-white">{SITE.email}</a></li>
        <li>
          <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-semibold text-brand-bright transition-colors hover:text-white">
            Escribinos por WhatsApp
          </a>
        </li>
      </ul>
    </details>

    <details class="foot-col" open>
      <summary class="foot-col__head text-xs font-bold uppercase leading-4 tracking-[0.2em] text-brand-bright">
        <span>Red internacional</span>
        <svg class="foot-col__chev h-4 w-4 shrink-0 text-brand-bright sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <p class="mt-3 text-[13px] leading-relaxed text-white/70 sm:mt-4 sm:text-sm">
        Miembro independiente de <span class="font-semibold text-white">BOKS International</span>, una red global de firmas profesionales.
      </p>
      <a
        href={SITE.linkedin}
        target="_blank"
        rel="noopener"
        class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-white sm:mt-4 transition-colors hover:text-brand-bright"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z" />
        </svg>
        LinkedIn
      </a>
    </details>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 pb-24 text-xs text-white/75 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:pb-6">
      <p>© {year} {SITE.legalName} · Todos los derechos reservados.</p>
      <p class="font-display italic text-white/75" style="font-style:italic">G&amp;G · San Isidro · desde 1967</p>
    </div>
  </div>
</footer>
