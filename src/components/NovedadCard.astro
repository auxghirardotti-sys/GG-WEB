---
/**
 * Tarjeta de prensa ("El estudio en los medios"): la foto de la nota arriba, y abajo el
 * medio en su color, la fecha y el titular.
 *
 * La foto sale del <meta og:image> de la nota, que es la imagen que el propio medio publica
 * para que la muestre quien enlaza a ella. La baja y la optimiza scripts/fotos-prensa.mjs
 * en una sola pasada y quedan versionadas en src/assets/prensa, así el build no depende de
 * la red ni de que los sitios de los medios estén arriba. Al agregar una nota se corre
 * `npm run prensa:fotos` y listo: no hay que elegir ni recortar nada a mano.
 *
 * (Nota para el que venga después: si al bajar una og:image te da 400, revisá que hayas
 * decodificado los &amp; de la URL. Los medios sobre Arc —Infobae, La Nación, El Cronista—
 * llevan un token en el query string y sin decodificar parece que estuvieran bloqueando.)
 *
 * Las tres notas viejas (2016, 2022, 2023) no tienen link externo y por lo tanto no tienen
 * foto: la tarjeta se dibuja sin imagen. No salen en la portada, que muestra las 6 últimas.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { fmtDate } from '../data/format';
import { fotoPrensa } from '../data/images';
import { colorDeMedio } from '../data/medios';

interface Props {
  post: CollectionEntry<'novedades'>;
  /** h2 en /novedades (es el encabezado de la lista); h3 en la home, que ya tiene su h2. */
  as?: 'h2' | 'h3';
  /** El excerpt solo en /novedades: en la home estiraría la tarjeta sin necesidad. */
  showExcerpt?: boolean;
  /** Clases de ancho. Por defecto basis-% para el carrusel con scroll; la marquesina
   *  necesita ancho FIJO, porque dentro de un track width:max-content un basis en
   *  porcentaje no tiene contra qué resolverse. */
  ancho?: string;
  /** true en la copia que la marquesina usa para cerrar el bucle: es la misma nota otra
   *  vez, así que no debe leerla el lector de pantalla ni recibir foco al tabular. */
  duplicado?: boolean;
}
const {
  post: p,
  as: Heading = 'h3',
  showExcerpt = false,
  ancho = 'basis-[70%] sm:basis-[46%] lg:basis-[31.5%]',
  duplicado = false,
} = Astro.props;

const foto = fotoPrensa(p.id);
const colorMedio = colorDeMedio(p.data.source);
---

<a
  href={p.data.externalUrl ?? `/novedades/${p.id}`}
  target={p.data.externalUrl ? '_blank' : undefined}
  rel={p.data.externalUrl ? 'noopener' : undefined}
  aria-hidden={duplicado ? 'true' : undefined}
  tabindex={duplicado ? -1 : undefined}
  class:list={['surface-card lift group flex shrink-0 snap-start flex-col overflow-hidden rounded-2xl sm:rounded-lg', ancho]}
>
  {foto && (
    <div class="aspect-[16/9] overflow-hidden bg-paper-2">
      <Image
        src={foto}
        alt=""
        aria-hidden="true"
        widths={[380, 760]}
        sizes="(min-width: 1024px) 350px, 70vw"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    {/* El nombre va en el color del diario. En caja normal, no en versalitas:
        "IPROFESIONAL" le rompe la i minúscula, que es parte de su marca.
        El tracking va inline: .font-display está fuera de @layer con letter-spacing
        -0.02em fijo y le gana a las utilidades tracking-*. */}
    {p.data.source && (
      <span
        class="font-display block text-[15px] leading-none lg:text-[17px]"
        style={`letter-spacing:-0.02em;color:${colorMedio}`}
      >
        {p.data.source}
      </span>
    )}

    <time
      datetime={p.data.date.toISOString()}
      class="mt-1.5 block text-[10px] font-semibold uppercase tracking-[0.16em] text-muted lg:text-[11px]"
    >
      {fmtDate(p.data.date)}
    </time>

    <Heading
      class="font-display mt-2 text-balance text-[16px] leading-[1.22] text-ink transition-colors group-hover:text-brand-ink lg:mt-2.5 lg:text-[18px]"
      style="font-weight:700"
    >
      {p.data.title}
    </Heading>

    {showExcerpt && (
      <p class="mt-2.5 text-[13px] leading-snug text-body line-clamp-3 lg:text-sm">
        {p.data.excerpt}
      </p>
    )}

    <span class="mt-auto inline-flex items-center gap-1 pt-4 text-xs font-bold text-brand-ink lg:text-sm">
      Leer más
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.6L10.2 5.3a.75.75 0 1 1 1.1-1.02l5.5 5.25a.75.75 0 0 1 0 1.04l-5.5 5.25a.75.75 0 1 1-1.1-1.02l4.15-3.95H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
      </svg>
    </span>
  </div>
</a>
