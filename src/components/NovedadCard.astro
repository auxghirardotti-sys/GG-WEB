---
/**
 * Tarjeta de prensa ("El estudio en los medios").
 *
 * La banda de arriba lleva el nombre del medio en blanco sobre SU color, con la textura
 * dry-brush del manual como veladura.
 *
 * No usa la foto de la nota, y no es por prolijidad: probé las 14 y seis están bloqueadas
 * por el propio medio (Infobae, La Nación y El Cronista corren sobre Arc y devuelven 403
 * sin token y 400 con el token que viene en su og:image), tres no tienen link externo y de
 * las cinco que quedan hay una de 2,4 MB. Con fotos, las cuatro notas más recientes —que
 * son justo las que abren la portada— quedarían sin imagen. Generada, la banda funciona en
 * las 14 y en toda nota futura, no depende de que el medio nos deje y no pesa nada.
 *
 * El color de cada medio sale de src/data/medios.ts. El isotipo de agua queda en el cuerpo
 * blanco: ahora que la banda es del color del diario, es la firma de que la tarjeta es
 * nuestra.
 *
 * La fecha va en el cuerpo y no en la banda a propósito: a 10px sobre el naranja de Infobae
 * no llegaría al 4,5:1 que pide el texto chico. Sobre blanco da 5,05:1.
 */
import type { CollectionEntry } from 'astro:content';
import Logo from './Logo.astro';
import { fmtDate } from '../data/format';
import { colorDeMedio } from '../data/medios';

interface Props {
  post: CollectionEntry<'novedades'>;
  /** h2 en /novedades (es el encabezado de la lista); h3 en la home, que ya tiene su h2. */
  as?: 'h2' | 'h3';
  /** El excerpt solo en /novedades: en la home estiraría la tarjeta sin necesidad. */
  showExcerpt?: boolean;
}
const { post: p, as: Heading = 'h3', showExcerpt = false } = Astro.props;

// Corre la veta de la veladura según el título: ninguna banda repite la misma pincelada, y
// la misma nota muestra siempre la suya, igual en la home que en /novedades.
const brushX = (p.data.title.length * 13) % 360;
const colorMedio = colorDeMedio(p.data.source);
---

{/* overflow-hidden para que la banda respete las esquinas redondeadas. No rompe nada: el
    box-shadow de .surface-card va por fuera del elemento, y el ::after del spotlight usa
    inset:0 con border-radius:inherit, así que recortarlo es justamente lo que corresponde. */}
<a
  href={p.data.externalUrl ?? `/novedades/${p.id}`}
  target={p.data.externalUrl ? '_blank' : undefined}
  rel={p.data.externalUrl ? 'noopener' : undefined}
  class="surface-card lift group relative flex shrink-0 basis-[70%] snap-start flex-col overflow-hidden rounded-2xl sm:basis-[46%] sm:rounded-lg lg:basis-[31.5%]"
>
  {p.data.source ? (
    <div class="relative px-4 pb-3.5 pt-8 sm:px-5 sm:pt-10" style={`background-color:${colorMedio}`}>
      <div class="brush-veil absolute inset-0" style={`--brush-x:-${brushX}px`} aria-hidden="true"></div>
      {/* El tracking va inline: .font-display está fuera de @layer con letter-spacing
          -0.02em fijo y le gana a las utilidades tracking-*. */}
      <span
        class="font-display relative block text-[22px] leading-[0.92] text-white lg:text-[28px]"
        style="letter-spacing:-0.035em"
      >
        {p.data.source}
      </span>
    </div>
  ) : (
    /* Nota sin medio: el filete rojo del manual, para que no quede una tarjeta descabezada. */
    <div class="brush-band h-5" aria-hidden="true"></div>
  )}

  <div class="relative flex flex-1 flex-col p-4 sm:p-5">
    <Logo class="pointer-events-none absolute bottom-3 right-3 h-7 w-auto text-brand/10 lg:h-8" />

    <time
      datetime={p.data.date.toISOString()}
      class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted lg:text-[11px]"
    >
      {fmtDate(p.data.date)}
    </time>

    <Heading
      class="font-display mt-2 text-balance text-[16px] leading-[1.22] text-ink transition-colors group-hover:text-brand-ink lg:mt-2.5 lg:text-[19px]"
      style="font-weight:700"
    >
      {p.data.title}
    </Heading>

    {showExcerpt && (
      <p class="mt-3 border-l-2 border-brand-soft pl-3 text-[13px] leading-snug text-body line-clamp-3 lg:text-sm">
        {p.data.excerpt}
      </p>
    )}

    <span class="relative mt-auto inline-flex items-center gap-1 pt-4 text-xs font-bold text-brand-ink lg:text-sm">
      Leer más
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.6L10.2 5.3a.75.75 0 1 1 1.1-1.02l5.5 5.25a.75.75 0 0 1 0 1.04l-5.5 5.25a.75.75 0 1 1-1.1-1.02l4.15-3.95H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
      </svg>
    </span>
  </div>
</a>
