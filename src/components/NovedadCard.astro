---
/**
 * Tarjeta de prensa ("El estudio en los medios").
 *
 * La idea: en una sección que se llama así, el nombre del medio era lo MÁS chico de la
 * tarjeta (11px gris) cuando en realidad es lo que impresiona. Va al revés: el medio en
 * grande y en rojo de marca es el ancla visual, con un filete dry-brush del manual debajo
 * y el isotipo como marca de agua, para que la tarjeta siga leyéndose como de G&G aunque
 * lo más grande diga INFOBAE.
 *
 * No necesita ningún campo nuevo: usa date, source, title, excerpt y externalUrl, que ya
 * están en las 14 notas. Nadie tiene que cargar un dato extra al publicar la próxima.
 */
import type { CollectionEntry } from 'astro:content';
import Logo from './Logo.astro';
import { fmtDate } from '../data/format';
import { colorDeMedio } from '../data/medios';

interface Props {
  post: CollectionEntry<'novedades'>;
  /** h2 en /novedades (es el encabezado de la lista); h3 en la home, que ya tiene su h2. */
  as?: 'h2' | 'h3';
  /** El excerpt solo en /novedades: en la home estiraría la tarjeta sin necesidad. */
  showExcerpt?: boolean;
}
const { post: p, as: Heading = 'h3', showExcerpt = false } = Astro.props;

// Corre la veta del filete según el título: ninguna tarjeta repite la misma pincelada, y la
// misma nota muestra siempre la suya, igual en la home que en /novedades.
const brushX = (p.data.title.length * 13) % 240;
// El nombre va en el color del diario; el filete y el isotipo siguen en rojo G&G.
const colorMedio = colorDeMedio(p.data.source);
---

{/* El `relative` es necesario, no decorativo: .surface-card solo recibe position:relative
    dentro de @media (pointer: fine), así que en celular la marca de agua se posicionaría
    contra el <body>. */}
<a
  href={p.data.externalUrl ?? `/novedades/${p.id}`}
  target={p.data.externalUrl ? '_blank' : undefined}
  rel={p.data.externalUrl ? 'noopener' : undefined}
  class="surface-card lift group relative flex shrink-0 basis-[70%] snap-start flex-col rounded-2xl p-4 sm:basis-[46%] sm:rounded-lg sm:p-5 lg:basis-[31.5%]"
>
  <Logo class="pointer-events-none absolute bottom-3 right-3 h-7 w-auto text-brand/10 lg:h-8" />

  <time
    datetime={p.data.date.toISOString()}
    class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted lg:text-[11px]"
  >
    {fmtDate(p.data.date)}
  </time>

  {/* En caja normal, no en versalitas: "iProfesional" y "La Nación" se escriben así y
      "IPROFESIONAL" le rompe la i minúscula, que es parte de su marca. Además la fecha de
      arriba ya va en versalitas, y dos bloques en mayúscula apilados se pisan.
      El tracking va inline a propósito: .font-display está fuera de @layer con
      letter-spacing:-0.02em fijo, y le gana a las utilidades tracking-*. */}
  {p.data.source && (
    <span
      class="font-display mt-1 block text-[22px] leading-[0.92] lg:mt-1.5 lg:text-[28px]"
      style={`letter-spacing:-0.035em;color:${colorMedio}`}
    >
      {p.data.source}
    </span>
  )}

  {/* Los -mx-* espejan el p-4/sm:p-5 de la tarjeta para que el filete vaya a sangre.
      Si algún día cambia ese padding, hay que cambiarlos acá también. */}
  <div
    class="brush-band brush-rule -mx-4 mt-3 sm:-mx-5 lg:mt-3.5"
    style={`--brush-x:-${brushX}px`}
    aria-hidden="true"
  >
  </div>

  <Heading
    class="font-display mt-3 text-balance text-[16px] leading-[1.22] text-ink transition-colors group-hover:text-brand-ink lg:mt-4 lg:text-[19px]"
    style="font-weight:700"
  >
    {p.data.title}
  </Heading>

  {showExcerpt && (
    <p class="mt-3 border-l-2 border-brand-soft pl-3 text-[13px] leading-snug text-body line-clamp-3 lg:text-sm">
      {p.data.excerpt}
    </p>
  )}

  <span class="relative mt-auto inline-flex items-center gap-1 pt-4 text-xs font-bold text-brand-ink lg:text-sm">
    Leer más
    <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.6L10.2 5.3a.75.75 0 1 1 1.1-1.02l5.5 5.25a.75.75 0 0 1 0 1.04l-5.5 5.25a.75.75 0 1 1-1.1-1.02l4.15-3.95H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
    </svg>
  </span>
</a>
