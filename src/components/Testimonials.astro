---
// Prueba social en banda OSCURA, versión compacta: citas cortas en texto plano
// (más creíbles que el display bold), atribución solo por rubro, tarjetas chicas.
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';
import { TESTIMONIALS } from '../data/site';
---

<section class="surface-ink">
  <div class="mx-auto max-w-pagina px-4 py-6 sm:px-6 sm:py-8">
    <div data-reveal>
      <Kicker text="Casos reales" light />
      <h2 class="title-clip mt-3 max-w-2xl font-display text-xl leading-tight text-white sm:text-2xl" style="font-weight:700">
        En palabras de quienes ya trabajan con nosotros
      </h2>
    </div>

    <div data-carousel>
    <div class="no-scrollbar mt-4 flex snap-x snap-mandatory gap-3 overflow-x-auto pb-3 sm:mt-5 lg:grid lg:grid-cols-3 lg:overflow-visible lg:pb-0" data-carousel-track data-reveal-stagger>
      {
        TESTIMONIALS.map((t) => (
          <figure class="flex shrink-0 basis-[70%] snap-start flex-col rounded-md border border-white/10 bg-ink-2/60 p-4 sm:basis-[45%] lg:basis-auto">
            <blockquote class="flex-1 text-sm italic leading-relaxed text-white/85">
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-3 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.14em] text-white/50">
              <Icon name={((t as any).icon || 'chat') as any} class="h-3.5 w-3.5 shrink-0 text-brand-bright/70" />
              <span>{t.who}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <div class="mt-3 flex justify-center gap-2 lg:hidden">
      {TESTIMONIALS.map(() => (
        <span data-carousel-dot class="h-2 w-2 rounded-full bg-line transition-colors"></span>
      ))}
    </div>
    </div>
  </div>
</section>
