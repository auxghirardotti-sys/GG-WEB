---
// Prueba social: citas anonimizadas por industria en Fraunces italic con sello rojo.
import Kicker from './Kicker.astro';
import { TESTIMONIALS } from '../data/site';
---

<section class="surface-paper-soft">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
    <div data-reveal>
      <Kicker text="Confían en nosotros" />
      <h2 class="mt-4 max-w-2xl font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
        Lo que dicen las empresas que asesoramos
      </h2>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3" data-reveal-stagger>
      {
        TESTIMONIALS.map((t) => (
          <figure class="lift flex flex-col rounded-sm border-t-2 border-brand surface-card p-7">
            <svg class="h-7 w-7 text-brand-ink/30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M9.5 6C6.5 6 4 8.6 4 11.8V18h6v-6H7.2c0-1.7 1-2.9 2.8-3.2L9.5 6Zm10 0c-3 0-5.5 2.6-5.5 5.8V18h6v-6h-2.8c0-1.7 1-2.9 2.8-3.2L19.5 6Z" />
            </svg>
            <blockquote class="mt-4 flex-1 font-display text-lg italic leading-relaxed text-ink" style="font-weight:700;font-style:italic">
              {t.quote}
            </blockquote>
            <figcaption class="mt-6 text-xs font-semibold uppercase tracking-[0.16em] text-muted">
              {t.who}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
