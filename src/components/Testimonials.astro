---
// Prueba social en banda OSCURA (contraste cinematográfico on-brand): citas en blanco,
// acentos rojos, ícono por rubro. Fondo surface-ink (negro con glow rojo animado).
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';
import { TESTIMONIALS } from '../data/site';
---

<section class="surface-ink">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
    <div data-reveal>
      <Kicker text="Casos reales" light />
      <h2 class="mt-4 max-w-2xl font-display text-3xl leading-tight text-white sm:text-4xl" style="font-weight:700">
        En palabras de quienes ya trabajan con nosotros
      </h2>
    </div>

    <div data-carousel>
    <div class="no-scrollbar mt-10 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-3 lg:grid lg:grid-cols-3 lg:overflow-visible lg:pb-0" data-carousel-track data-reveal-stagger>
      {
        TESTIMONIALS.map((t) => (
          <figure class="lift flex shrink-0 basis-[80%] snap-start flex-col rounded-md border border-white/10 bg-ink-2/60 p-7 sm:basis-[55%] lg:basis-auto">
            <svg class="h-7 w-7 text-brand-bright/50" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M9.5 6C6.5 6 4 8.6 4 11.8V18h6v-6H7.2c0-1.7 1-2.9 2.8-3.2L9.5 6Zm10 0c-3 0-5.5 2.6-5.5 5.8V18h6v-6h-2.8c0-1.7 1-2.9 2.8-3.2L19.5 6Z" />
            </svg>
            <blockquote class="mt-4 flex-1 font-display text-lg italic leading-relaxed text-white" style="font-weight:700;font-style:italic">
              {t.quote}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.16em] text-white/55">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-bright/15 text-brand-bright">
                <Icon name={((t as any).icon || 'chat') as any} class="h-4 w-4" />
              </span>
              <span>{t.who}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <div class="mt-4 flex justify-center gap-2 lg:hidden">
      {TESTIMONIALS.map(() => (
        <span data-carousel-dot class="h-2 w-2 rounded-full bg-line transition-colors"></span>
      ))}
    </div>
    </div>
  </div>
</section>
