---
// "Cómo trabajamos" — 4 pasos NUMERADOS sobre fondo claro, con CTA al diagnóstico.
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';
import { PROCESS, waLinkFor } from '../data/site';
---

<section id="como-trabajamos" class="scroll-mt-20 surface-paper-soft">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
    <div class="max-w-2xl" data-reveal>
      <Kicker text="Cómo trabajamos" />
      <h2 class="mt-4 font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
        Empezar es simple. Y la primera charla no tiene costo.
      </h2>
    </div>

    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        PROCESS.map((p) => (
          <li class="surface-card relative overflow-hidden rounded-lg p-6 text-left">
            <span
              class="pointer-events-none absolute -right-1 -top-4 select-none font-display text-7xl text-brand/10"
              style="font-weight:800"
              aria-hidden="true"
            >
              {p.step}
            </span>
            <span class="relative flex h-12 w-12 items-center justify-center rounded-md bg-brand/10 text-brand">
              <Icon name={p.icon as any} class="h-7 w-7" />
            </span>
            <h3 class="relative mt-4 font-display text-lg text-ink" style="font-weight:700">{p.title}</h3>
            <p class="relative mt-1.5 text-sm leading-relaxed text-body">{p.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-8" data-reveal>
      <a
        href={waLinkFor('Hola, quiero el diagnóstico sin cargo.')}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-md bg-brand px-7 py-3.5 text-base font-bold text-white transition-colors hover:bg-brand-ink"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Z" />
          <path d="M12.04 2C6.56 2 2.1 6.45 2.1 11.93c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.92 9.92 0 0 0 4.79 1.22h.01c5.47 0 9.93-4.45 9.93-9.93A9.86 9.86 0 0 0 12.04 2Zm0 18.16a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38 8.27 8.27 0 0 1 8.25-8.25 8.2 8.2 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.41 5.84 8.27 8.27 0 0 1-8.24 8.23Z" />
        </svg>
        Pedir el diagnóstico sin cargo
      </a>
    </div>
  </div>
</section>
