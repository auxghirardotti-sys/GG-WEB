---
// Bento grid interactivo de industrias (estilo Apple): mosaico de bloques de
// tamaños variados. Al tocar un bloque, un panel master-detail muestra una
// descripción honesta de qué cuidamos en ese sector (sin métricas ni casos).
// Patrón master-detail para evitar reflow feo. JS vanilla scopeado por id raíz.
import Kicker from './Kicker.astro';
import { INDUSTRIES } from '../data/site';

// Descripción honesta por industria (clave = nombre exacto). Con fallback genérico.
const DESC: Record<string, string> = {
  'Agropecuario':
    'Tributación agropecuaria, retenciones, IVA y la operatoria de granos. Conocemos el negocio desde el campo y desde los números.',
  'Software y tecnología':
    'Régimen de Economía del Conocimiento, facturación al exterior y estructuras para escalar sin sustos impositivos.',
  'Construcción':
    'Certificaciones de obra, anticipos, IVA de la construcción y el manejo de costos a lo largo de proyectos extensos.',
  'Desarrollos inmobiliarios':
    'Fideicomisos, estructura de los emprendimientos y el tratamiento fiscal de la compraventa y la renta.',
  'Energía':
    'Marcos regulatorios, inversiones de largo plazo y la planificación fiscal de proyectos intensivos en capital.',
  'Minería':
    'Estabilidad fiscal, regalías y la operatoria de un sector con fuerte componente internacional.',
  'Industria metalmecánica':
    'Costos, stock, regímenes de promoción y la rentabilidad real de la operación fabril.',
  'Industria eléctrica':
    'Cadena de producción y distribución, contratos y el tratamiento impositivo de bienes de capital.',
  'Importadores':
    'Operatoria de comercio exterior, valuación, precios de transferencia y el impacto impositivo de importar.',
  'Agencias de publicidad':
    'Facturación por proyectos, honorarios, retenciones y la operatoria con medios y proveedores.',
  'Estudios de abogados':
    'Honorarios, estructura societaria del estudio y la planificación impositiva de los socios.',
  'Hotelería':
    'Estacionalidad, IVA del sector, personal y la rentabilidad de la operación hotelera.',
};

const FALLBACK = 'Conocemos la operatoria y los riesgos impositivos particulares de este sector.';
const descOf = (name: string) => DESC[name] ?? FALLBACK;

// Tamaños variados para el efecto bento sobre 6 columnas (sm+). El patrón
// cierra prolijo para 12 industrias (filas que suman 6) y, si el array cambia,
// el módulo mantiene una grilla razonable. En mobile: grid de 2 columnas.
const SPANS = [
  'sm:col-span-4',
  'sm:col-span-2',
  'sm:col-span-2',
  'sm:col-span-4',
  'sm:col-span-3',
  'sm:col-span-3',
  'sm:col-span-2',
  'sm:col-span-2',
  'sm:col-span-2',
  'sm:col-span-3',
  'sm:col-span-3',
  'sm:col-span-6',
];
const spanOf = (i: number) => SPANS[i % SPANS.length];

const items = INDUSTRIES as string[];
const first = items[0] ?? '';
---

<section id="ind-bento" class="surface-paper-soft scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
    <!-- 1) Encabezado -->
    <div data-reveal>
      <Kicker text="Tu sector" />
      <h2 class="mt-4 max-w-2xl font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
        Industrias con las que <em class="accent" style="font-style:italic">trabajamos</em>
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-body">
        Cada industria tiene sus reglas, sus riesgos y sus oportunidades fiscales. Tocá un rubro y
        te contamos cómo lo trabajamos.
      </p>
    </div>

    <!-- 2) Bento grid de tiles -->
    <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-6" data-reveal>
      {
        items.map((name, i) => (
          <button
            type="button"
            data-haptic
            data-idx={i}
            data-name={name}
            data-desc={descOf(name)}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class:list={[
              'ind-tile lift group flex min-h-[72px] items-center justify-between gap-3 rounded-lg border p-4 text-left transition-colors',
              spanOf(i),
              i === 0
                ? 'is-active border-brand bg-brand text-white'
                : 'border-line surface-card text-ink',
            ]}
          >
            <span class="font-display text-base leading-tight sm:text-lg" style="font-weight:700">
              {name}
            </span>
            <span
              class:list={[
                'ind-dot h-2.5 w-2.5 shrink-0 rounded-full transition-colors',
                i === 0 ? 'bg-white' : 'bg-brand',
              ]}
              aria-hidden="true"
            ></span>
          </button>
        ))
      }
    </div>

    <!-- 2) Panel detalle (master-detail) -->
    <div class="surface-card mt-6 rounded-lg p-6 sm:p-8" data-reveal>
      <div id="ind-panel" class="transition-opacity duration-300">
        <h3 id="ind-panel-title" class="font-display text-xl text-ink" style="font-weight:700">
          {first}
        </h3>
        <p id="ind-panel-desc" class="mt-2 text-body">
          {descOf(first)}
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('ind-bento');
  if (root) {
    const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('.ind-tile'));
    const panel = root.querySelector<HTMLElement>('#ind-panel');
    const titleEl = root.querySelector<HTMLElement>('#ind-panel-title');
    const descEl = root.querySelector<HTMLElement>('#ind-panel-desc');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setActive(btn: HTMLButtonElement) {
      tiles.forEach((t) => {
        const on = t === btn;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-pressed', on ? 'true' : 'false');
        // Tile activo: bg-brand + texto blanco; inactivo: surface-card + tinta.
        t.classList.toggle('border-brand', on);
        t.classList.toggle('bg-brand', on);
        t.classList.toggle('text-white', on);
        t.classList.toggle('border-line', !on);
        t.classList.toggle('surface-card', !on);
        t.classList.toggle('text-ink', !on);
        const dot = t.querySelector('.ind-dot');
        if (dot) {
          dot.classList.toggle('bg-white', on);
          dot.classList.toggle('bg-brand', !on);
        }
      });
    }

    function fill(btn: HTMLButtonElement) {
      const name = btn.dataset.name || '';
      const desc = btn.dataset.desc || '';
      if (titleEl) titleEl.textContent = name;
      if (descEl) descEl.textContent = desc;
    }

    function select(btn: HTMLButtonElement) {
      setActive(btn);
      // Transición suave de opacidad del texto del panel al cambiar.
      if (reduce || !panel) {
        fill(btn);
        return;
      }
      panel.style.opacity = '0';
      window.setTimeout(() => {
        fill(btn);
        panel.style.opacity = '1';
      }, 150);
    }

    tiles.forEach((btn) => {
      btn.addEventListener('click', () => select(btn));
    });
  }
</script>
