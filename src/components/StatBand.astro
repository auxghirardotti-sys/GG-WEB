---
// Banda de cifras Fraunces gigantes separadas por filetes verticales, con count-up.
interface Stat {
  value: number;
  suffix?: string;
  /** Texto fijo en lugar de número con count-up (ej: "BOKS") */
  text?: string;
  label: string;
}
interface Props {
  stats: Stat[];
  /** true sobre fondo oscuro */
  light?: boolean;
  class?: string;
}
const { stats, light = false, class: className = '' } = Astro.props;
const numColor = light ? 'text-brand-bright' : 'text-brand';
const labelColor = light ? 'text-white/55' : 'text-muted';
const divide = light ? 'divide-white/15' : 'divide-line-strong';
// Columnas según cantidad de cifras (evita celdas vacías al cambiar el set de stats).
const colsClass =
  ({ 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-3', 4: 'sm:grid-cols-4', 5: 'sm:grid-cols-5' } as Record<number, string>)[
    stats.length
  ] ?? 'sm:grid-cols-4';
---

<dl
  class:list={[
    'grid grid-cols-2 divide-y sm:divide-y-0 sm:divide-x',
    colsClass,
    divide,
    className,
  ]}
  data-reveal
>
  {
    stats.map((s) => (
      <div class="flex flex-col items-start px-2 py-5 sm:px-7">
        <dt
          class:list={['font-display tabular text-4xl leading-none sm:text-5xl', numColor]}
          style="font-weight:800"
        >
          {s.text ? (
            <span>{s.text}</span>
          ) : (
            <span data-countup={s.value} data-suffix={s.suffix ?? ''}>{s.value}{s.suffix ?? ''}</span>
          )}
        </dt>
        <dd class:list={['mt-2 text-xs font-medium uppercase tracking-[0.14em]', labelColor]}>
          {s.label}
        </dd>
      </div>
    ))
  }
</dl>
