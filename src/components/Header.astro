---
import { SERVICES } from '../data/services';
import { waLink } from '../data/site';

const links = [
  { href: '/quienes-somos', label: 'Quiénes Somos' },
  { href: '/novedades', label: 'Novedades' },
  { href: '/contacto', label: 'Contacto' },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-3" aria-label="Ghirardotti & Ghirardotti — Inicio">
      <img src="/logo-gg.png" alt="" class="h-9 w-9" width="36" height="36" />
      <span class="leading-tight">
        <span class="block text-[15px] font-extrabold tracking-tight text-ink">Ghirardotti & Ghirardotti</span>
        <span class="block text-[11px] font-medium uppercase tracking-widest text-muted">Estudio contable e impositivo</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      <a
        href="/"
        class:list={[
          'rounded-lg px-3 py-2 text-sm font-semibold transition-colors',
          current === '/' ? 'text-brand' : 'text-ink hover:text-brand',
        ]}
      >
        Inicio
      </a>

      <div class="group relative">
        <a
          href="/#servicios"
          class:list={[
            'flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-semibold transition-colors',
            current.startsWith('/servicios') ? 'text-brand' : 'text-ink hover:text-brand',
          ]}
        >
          Servicios
          <svg class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
          </svg>
        </a>
        <div
          class="invisible absolute left-0 top-full w-64 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
        >
          <div class="overflow-hidden rounded-xl border border-line bg-white py-2 shadow-xl">
            {SERVICES.map((s) => (
              <a
                href={`/servicios/${s.slug}`}
                class:list={[
                  'block px-4 py-2.5 text-sm font-medium transition-colors hover:bg-brand-soft hover:text-brand',
                  current === `/servicios/${s.slug}` ? 'text-brand' : 'text-body',
                ]}
              >
                {s.title}
              </a>
            ))}
          </div>
        </div>
      </div>

      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'rounded-lg px-3 py-2 text-sm font-semibold transition-colors',
            current.startsWith(l.href) ? 'text-brand' : 'text-ink hover:text-brand',
          ]}
        >
          {l.label}
        </a>
      ))}

      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        class="ml-2 inline-flex items-center gap-2 rounded-full bg-brand px-4 py-2 text-sm font-bold text-white shadow-sm transition-colors hover:bg-brand-dark"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Z" />
          <path d="M12.04 2C6.56 2 2.1 6.45 2.1 11.93c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.92 9.92 0 0 0 4.79 1.22h.01c5.47 0 9.93-4.45 9.93-9.93A9.86 9.86 0 0 0 12.04 2Zm0 18.16a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38 8.27 8.27 0 0 1 8.25-8.25 8.2 8.2 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.41 5.84 8.27 8.27 0 0 1-8.24 8.23Z" />
        </svg>
        Hablar con un asesor
      </a>
    </nav>

    <button
      id="menu-btn"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-ink hover:bg-paper lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-white lg:hidden">
    <nav class="mx-auto max-w-6xl space-y-1 px-4 py-4 sm:px-6" aria-label="Navegación móvil">
      <a href="/" class="block rounded-lg px-3 py-2.5 text-base font-semibold text-ink hover:bg-paper">Inicio</a>
      <p class="px-3 pb-1 pt-3 text-xs font-bold uppercase tracking-widest text-muted">Servicios</p>
      {SERVICES.map((s) => (
        <a href={`/servicios/${s.slug}`} class="block rounded-lg px-3 py-2.5 text-base font-medium text-body hover:bg-paper">
          {s.title}
        </a>
      ))}
      <div class="pt-2">
        {links.map((l) => (
          <a href={l.href} class="block rounded-lg px-3 py-2.5 text-base font-semibold text-ink hover:bg-paper">
            {l.label}
          </a>
        ))}
      </div>
      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        class="mt-3 flex items-center justify-center gap-2 rounded-full bg-brand px-4 py-3 text-base font-bold text-white"
      >
        Hablar con un asesor por WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(isOpen));
    btn.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
