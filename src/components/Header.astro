---
import { SERVICES } from '../data/services';
import { waLink } from '../data/site';
import Icon from './Icon.astro';

const links = [
  { href: '/quienes-somos', label: 'Quiénes Somos' },
  { href: '/novedades', label: 'Novedades' },
  { href: '/contacto', label: 'Contacto' },
];

// Accesos directos a info clave (anclas en la home)
const quick = [
  { href: '/#como-trabajamos', label: 'Cómo trabajamos' },
  { href: '/#equipo', label: 'Equipo' },
  { href: '/#faq', label: 'Preguntas frecuentes' },
  { href: '/quienes-somos', label: 'Quiénes somos' },
];
const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(href + '/');
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b-2 border-brand bg-paper/90 backdrop-blur transition-all duration-200"
>
  <div class="mx-auto flex h-[72px] max-w-6xl items-center justify-between gap-4 px-4 transition-all duration-200 sm:px-6">
    <a href="/" class="flex items-center gap-3" aria-label="Ghirardotti & Ghirardotti — Inicio">
      <img src="/logo-gg.png" alt="" class="h-9 w-9" width="36" height="36" />
      <span class="leading-none">
        <span class="block font-display text-[22px] lowercase text-brand" style="font-weight:800;letter-spacing:-0.02em">ghirardotti</span>
        <span class="mt-0.5 block text-[9px] font-semibold uppercase tracking-[0.18em] text-muted">Tax and business advisors</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navegación principal">
      <a
        href="/"
        class:list={['underline-grow text-sm font-medium text-ink', current === '/' && 'is-active']}
      >
        Inicio
      </a>

      <div class="group relative">
        <a
          href="/#servicios"
          class:list={[
            'underline-grow flex items-center gap-1 text-sm font-medium text-ink',
            current.startsWith('/servicios') && 'is-active',
          ]}
        >
          Servicios
          <svg class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
          </svg>
        </a>
        <div class="invisible absolute left-1/2 top-full w-[40rem] max-w-[92vw] -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="grid grid-cols-2 gap-2 border border-line bg-paper p-3 shadow-[0_24px_60px_-32px_rgba(20,23,31,0.4)]">
            <div>
              <p class="px-3 pb-1 pt-2 text-[11px] font-bold uppercase tracking-[0.18em] text-muted">Servicios</p>
              {SERVICES.map((s) => (
                <a
                  href={`/servicios/${s.slug}`}
                  class:list={[
                    'flex items-center gap-3 rounded-sm px-3 py-2 transition-colors hover:bg-paper-2',
                    current === `/servicios/${s.slug}` ? 'text-brand-ink' : 'text-ink',
                  ]}
                >
                  <span class="text-brand"><Icon name={s.icon} class="h-5 w-5" /></span>
                  <span class="text-sm font-medium">{s.title}</span>
                </a>
              ))}
            </div>
            <div class="border-l border-line pl-2">
              <p class="px-3 pb-1 pt-2 text-[11px] font-bold uppercase tracking-[0.18em] text-muted">Ir directo a</p>
              {quick.map((q) => (
                <a href={q.href} class="flex items-center gap-2 rounded-sm px-3 py-2 text-sm font-medium text-ink transition-colors hover:bg-paper-2 hover:text-brand-ink">
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span>
                  {q.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      {links.map((l) => (
        <a
          href={l.href}
          class:list={['underline-grow text-sm font-medium text-ink', isActive(l.href) && 'is-active']}
        >
          {l.label}
        </a>
      ))}

      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-md bg-brand px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-ink"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Z" />
          <path d="M12.04 2C6.56 2 2.1 6.45 2.1 11.93c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.92 9.92 0 0 0 4.79 1.22h.01c5.47 0 9.93-4.45 9.93-9.93A9.86 9.86 0 0 0 12.04 2Zm0 18.16a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38 8.27 8.27 0 0 1 8.25-8.25 8.2 8.2 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.41 5.84 8.27 8.27 0 0 1-8.24 8.23Z" />
        </svg>
        Hablar con un socio
      </a>
    </nav>

    <button
      id="menu-btn"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md text-ink hover:bg-paper-2 lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-paper lg:hidden">
    <nav class="mx-auto max-w-6xl space-y-1 px-4 py-4 sm:px-6" aria-label="Navegación móvil">
      <a href="/" class="block py-2.5 font-display text-lg text-ink" style="font-weight:700">Inicio</a>
      <details class="group border-t border-line/70">
        <summary class="flex cursor-pointer list-none items-center justify-between py-3 font-display text-lg text-ink" style="font-weight:700">
          Servicios
          <svg class="faq-chevron h-5 w-5 text-brand transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="faq-answer">
          <div class="overflow-hidden pb-1">
            {SERVICES.map((s) => (
              <a href={`/servicios/${s.slug}`} class="flex items-center gap-3 py-2.5 text-base text-body">
                <span class="text-brand"><Icon name={s.icon} class="h-5 w-5" /></span>
                {s.title}
              </a>
            ))}
          </div>
        </div>
      </details>
      <p class="kicker pb-1 pt-4">Ir directo a</p>
      {quick.filter((q) => q.href.startsWith('/#')).map((q) => (
        <a href={q.href} class="flex items-center gap-2 py-2.5 text-base text-body">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span>
          {q.label}
        </a>
      ))}
      <div class="pt-2">
        {links.map((l) => (
          <a href={l.href} class="block py-2.5 font-display text-lg text-ink" style="font-weight:700">{l.label}</a>
        ))}
      </div>
      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        class="mt-3 flex items-center justify-center gap-2 rounded-md bg-brand px-4 py-3 text-base font-bold text-white"
      >
        Hablar con un socio por WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const header = document.getElementById('site-header');

  function setMenu(open) {
    if (!menu || !btn) return;
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  btn?.addEventListener('click', () => setMenu(menu?.classList.contains('hidden') ?? false));

  // Cerrar el menú mobile al tocar cualquier link
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // Escape cierra el menú mobile y suelta el foco del dropdown de servicios
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (menu && !menu.classList.contains('hidden')) setMenu(false);
    if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
  });

  // Shrink + sombra del header al scrollear
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) {
      header.classList.add('shadow-[0_8px_30px_-20px_rgba(20,23,31,0.45)]');
      header.querySelector('div')?.classList.add('!h-[60px]');
    } else {
      header.classList.remove('shadow-[0_8px_30px_-20px_rgba(20,23,31,0.45)]');
      header.querySelector('div')?.classList.remove('!h-[60px]');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
