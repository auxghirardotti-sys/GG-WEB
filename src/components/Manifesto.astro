---
// Banda cinematográfica: foto de campo (parallax + Ken Burns) con overlay y frase de marca.
import { Image } from 'astro:assets';
import { img } from '../data/images';

// La home agrupa secciones en pantallas completas y le pasa flex-1 a cada una para
// que se repartan el alto, por eso el <section> acepta clases desde afuera.
interface Props {
  class?: string;
  pre: string;
  accent: string;
  post?: string;
  /** Imagen de fondo (requerida) */
  image: string;
  /** object-position del recorte, ej '50% 80%' para mostrar más la parte de abajo */
  objectPos?: string;
  /** Velo oscuro: 'normal' o 'soft' (más claro + imagen con un toque de brillo) */
  veil?: 'normal' | 'soft';
}
const { pre, accent, post = '', image, objectPos, veil = 'normal', class: className = '' } = Astro.props;
const imgStyle = [
  objectPos && `object-position:${objectPos}`,
  veil === 'soft' && 'filter:brightness(1.12) saturate(1.04)',
]
  .filter(Boolean)
  .join(';');
---

<section class:list={['cine masthead-top', className]}>
  <div class="cine__media sd-parallax" data-parallax="0.16">
    <Image src={img(image)} alt="" aria-hidden="true" widths={[640, 1024, 1366]} sizes="100vw" format="webp" quality={70} class="kenburns" style={imgStyle || undefined} />
  </div>
  <div class:list={['cine__veil', veil === 'soft' && 'cine__veil--soft']}></div>
  <div class="mx-auto max-w-5xl px-4 py-6 sm:px-6 sm:py-10 lg:py-12" data-reveal>
    <p class="font-display text-2xl leading-[1.2] text-white sm:text-4xl lg:text-[2.75rem]" style="font-weight:800">
      {pre}{' '}
      <em class="text-brand-bright" style="font-style:italic">{accent}</em>{post}
    </p>
  </div>
</section>
