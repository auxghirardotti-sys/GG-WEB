---
// Banda oscura full-width con una sola frase grande Fraunces + palabra-acento roja italic.
interface Props {
  /** Texto antes de la palabra acento */
  pre: string;
  /** Palabra/frase en italic roja */
  accent: string;
  /** Texto después del acento */
  post?: string;
}
const { pre, accent, post = '' } = Astro.props;
---

<section class="surface-ink grid-ink">
  <div class="brush-band"></div>
  <div class="mx-auto max-w-5xl px-4 py-9 sm:px-6 lg:py-12" data-reveal>
    <p class="font-display text-xl leading-[1.25] text-white sm:text-3xl" style="font-weight:800">
      {pre}{' '}
      <em class="text-brand-bright" style="font-style:italic">{accent}</em>{post}
    </p>
  </div>
</section>
