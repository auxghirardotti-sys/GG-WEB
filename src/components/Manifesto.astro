---
// Banda cinematográfica: foto de campo (parallax + Ken Burns) con overlay y frase de marca.
interface Props {
  pre: string;
  accent: string;
  post?: string;
  /** Imagen de fondo */
  image?: string;
}
const { pre, accent, post = '', image = '/img/campo-vinedo.jpg' } = Astro.props;
import { Image } from 'astro:assets';
import { img } from '../data/images';
---

<section class="cine masthead-top">
  <div class="cine__media" data-parallax="0.16">
    <Image src={img(image)} alt="" aria-hidden="true" widths={[640, 1024, 1366]} sizes="100vw" format="webp" quality={70} class="kenburns" />
  </div>
  <div class="cine__veil"></div>
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:py-24" data-reveal>
    <p class="font-display text-2xl leading-[1.2] text-white sm:text-4xl lg:text-[2.75rem]" style="font-weight:800">
      {pre}{' '}
      <em class="text-brand-bright" style="font-style:italic">{accent}</em>{post}
    </p>
  </div>
</section>
