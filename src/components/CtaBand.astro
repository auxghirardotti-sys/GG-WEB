---
// Banda de cierre del embudo: fondo ROJO protagonista, CTA verde WhatsApp.
import { waLink } from '../data/site';

interface Props {
  title?: string;
  /** Palabra/frase acento subrayada, anexada al final del título */
  accent?: string;
  text?: string;
}

const {
  title = 'Tu primera consulta la responde',
  accent = 'un socio.',
  text = 'Contanos tu situación por WhatsApp y te respondemos a la brevedad. Sin compromiso y sin costo.',
} = Astro.props;
---

<section class="surface-ink grid-ink masthead-top overflow-hidden">
  <span class="ring-deco ring-float" aria-hidden="true" style="width:200px;height:200px;border-width:22px;border-color:rgba(226,59,59,0.22);top:-56px;right:6%"></span>
  <span class="ring-deco" aria-hidden="true" style="width:80px;height:80px;border-width:12px;border-color:rgba(226,59,59,0.3);bottom:24px;right:22%"></span>
  <div class="relative z-10 mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-12 sm:px-6 lg:flex-row lg:items-end lg:justify-between lg:py-16" data-reveal>
    <div>
      <h2 class="max-w-2xl font-display text-3xl leading-[1.1] text-white sm:text-4xl lg:text-[2.75rem]" style="font-weight:800">
        {title}{' '}
        {accent && <em class="accent" style="font-style:italic">{accent}</em>}
      </h2>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-white/75">{text}</p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-md bg-brand px-7 py-3.5 text-base font-bold text-white shadow-[0_14px_34px_-12px_rgba(0,0,0,0.5)] transition-transform hover:-translate-y-0.5"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Z" />
          <path d="M12.04 2C6.56 2 2.1 6.45 2.1 11.93c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.92 9.92 0 0 0 4.79 1.22h.01c5.47 0 9.93-4.45 9.93-9.93A9.86 9.86 0 0 0 12.04 2Zm0 18.16a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38 8.27 8.27 0 0 1 8.25-8.25 8.2 8.2 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.41 5.84 8.27 8.27 0 0 1-8.24 8.23Z" />
        </svg>
        Hablar con un socio
      </a>
      <a
        href="/contacto"
        class="inline-flex items-center rounded-md border border-white/50 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-white/15"
      >
        Ver todas las vías de contacto
      </a>
    </div>
  </div>
</section>
