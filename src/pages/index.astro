---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Kicker from '../components/Kicker.astro';
import StatBand from '../components/StatBand.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Diagnostico from '../components/Diagnostico.astro';
import Manifesto from '../components/Manifesto.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, waLink, waLinkFor, TEAM, INDUSTRIES, DIFFERENTIALS, FAQ, CLIENTS } from '../data/site';
import { fmtDate } from '../data/format';
import { Image } from 'astro:assets';
import { img } from '../data/images';

const posts = (await getCollection('novedades'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const stats = [
  { value: 60, suffix: '+', label: 'años de trayectoria' },
  { value: 500, suffix: '+', label: 'clientes asesorados' },
];

// Título del hero animado letra por letra (estilo VEX). "auditoría" en acento rojo; el punto en blanco.
const heroWords: { ch: string; accent: boolean }[][] = [
  ...'Asesoramiento fiscal, societario, contable y'
    .split(' ')
    .map((w) => [...w].map((ch) => ({ ch, accent: false }))),
  [
    ...[...'auditoría'].map((ch) => ({ ch, accent: true })),
    { ch: '.', accent: false },
  ],
];
let heroCharIndex = 0;

// Logos de clientes repetidos para que el marquee (translate -50%) cierre sin saltos.
const clientStrip = [...CLIENTS, ...CLIENTS, ...CLIENTS, ...CLIENTS];

// JSON-LD de FAQ para SEO
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Ghirardotti & Ghirardotti | Asesoramiento Fiscal, Societario, Contable y Auditoría · San Isidro"
  description={SITE.description}
  jsonLdExtra={faqJsonLd}
>
  <!-- HERO full-screen con video de fondo (look "VEX": media a sangre + liquid glass) -->
  <section class="cine masthead-top relative flex min-h-[92svh] flex-col lg:min-h-screen">
    <div class="cine__media sd-parallax" data-parallax="0.12">
      <video class="h-full w-full object-cover" autoplay loop muted playsinline preload="metadata" aria-hidden="true" poster={img('/img/hero-impositivo.jpg').src}>
        <source src="/hero-video.webm" type="video/webm" />
        <source src="/hero-video.mp4" type="video/mp4" />
      </video>
    </div>
    <!-- velo en gradiente: video crudo arriba, oscurecido abajo para legibilidad -->
    <div class="pointer-events-none absolute inset-0 z-0 bg-gradient-to-t from-black/80 via-black/35 to-transparent"></div>

    <div class="relative z-10 flex flex-1 flex-col justify-end">
      <div class="mx-auto w-full max-w-6xl px-4 pb-10 pt-28 sm:px-6 lg:pb-14">
        <div class="lg:grid lg:grid-cols-2 lg:items-end lg:gap-10">
          <div class="max-w-2xl">
        <div class="hero-in hero-in-1">
          <Kicker text="Est. 1967 · San Isidro" light />
        </div>
        <h1 id="hero-h1" class="font-display mt-6 leading-[1.05] tracking-tight text-white" style="font-weight:800; font-size: clamp(1.95rem, 6.2vw, 3.6rem)">
          {heroWords.map((word, wi) => (
            <Fragment>
              {wi > 0 && ' '}
              <span class="inline-block whitespace-nowrap">
                {word.map((c) => {
                  const i = heroCharIndex++;
                  return (
                    <span class:list={['hero-char', c.accent && 'accent']} style={`transition-delay:${i * 30}ms`}>{c.ch}</span>
                  );
                })}
              </span>
            </Fragment>
          ))}
        </h1>
        <p class="hero-in hero-in-3 mt-6 max-w-xl text-lg leading-[1.6] text-white/85">
          Acompañamos a empresas y grupos —locales e internacionales— con criterio estratégico, no
          solo para cumplir vencimientos.
        </p>
        <div class="hero-in hero-in-5 mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a
            href={waLinkFor('Hola, quisiera que un socio del estudio me asesore.')}
            target="_blank"
            rel="noopener"
            class="btn-shine inline-flex items-center gap-2 rounded-md bg-brand px-7 py-4 text-base font-bold text-white shadow-[0_16px_40px_-12px_rgba(205,51,51,0.7)]"
            data-magnetic
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Z" />
              <path d="M12.04 2C6.56 2 2.1 6.45 2.1 11.93c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.92 9.92 0 0 0 4.79 1.22h.01c5.47 0 9.93-4.45 9.93-9.93A9.86 9.86 0 0 0 12.04 2Zm0 18.16a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38 8.27 8.27 0 0 1 8.25-8.25 8.2 8.2 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.41 5.84 8.27 8.27 0 0 1-8.24 8.23Z" />
            </svg>
            Hablar con un socio
          </a>
          <a href="#servicios" class="liquid-glass inline-flex items-center rounded-md px-7 py-4 text-base font-semibold text-white transition-colors hover:bg-white hover:text-black">Ver servicios</a>
            </div>
          </div>

          <!-- columna derecha: tag de cristal (estilo VEX) -->
          <div class="mt-10 flex lg:mt-0 lg:justify-end">
            <div class="hero-in hero-in-4 liquid-glass max-w-sm rounded-xl px-6 py-4">
              <div class="flex items-center gap-2.5">
                <span class="text-brand-bright"><Icon name="globe" class="h-5 w-5" /></span>
                <span class="font-display text-base text-white" style="font-weight:700">Miembro de BOKS International</span>
              </div>
              <p class="mt-1 text-sm leading-relaxed text-white/70">Red global de firmas legales y contables</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Banda de stats sobre el hero -->
      <div class="relative z-10 border-t border-white/15">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <StatBand stats={stats} light />
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section id="servicios" class="scroll-mt-20 surface-paper-soft">
    <div class="mx-auto max-w-6xl px-4 py-9 sm:px-6 sm:py-12 lg:py-16">
      <div class="max-w-2xl" data-reveal>
        <Kicker text="Lo que hacemos" />
        <h2 class="title-clip mt-4 font-display text-3xl leading-tight text-brand sm:text-[2.75rem]" style="font-weight:700">
          Nuestros <em class="accent" style="font-style:italic">servicios</em>
        </h2>
        <p class="mt-4 text-base leading-relaxed text-body">
          Asesoramiento fiscal, contable, societario y patrimonial —con especialización en el agro— para tu empresa, bajo un mismo techo.
        </p>
      </div>

      <div class="mt-8">
        <ServiceIndex />
      </div>
    </div>
  </section>

  <!-- INDUSTRIAS (después de servicios) -->
  <section class="surface-paper-soft overflow-hidden py-9 sm:py-12 lg:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6" data-reveal>
      <Kicker text="Tu sector" />
      <h2 class="title-clip mt-4 max-w-2xl font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
        Industrias con las que <em class="accent" style="font-style:italic">trabajamos</em>
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-body">
        No es lo mismo asesorar a un campo que a una desarrolladora o a un estudio de abogados.
        Conocemos de adentro estos sectores:
      </p>
    </div>

    <div class="mt-7 flex flex-col gap-4 border-y border-line py-5 sm:mt-10 sm:py-6">
      <div class="marquee">
        <div class="marquee__track">
          {[...INDUSTRIES, ...INDUSTRIES].map((i) => (
            <span class="mx-6 flex items-center gap-3 whitespace-nowrap font-display text-xl text-ink/85 sm:text-2xl" style="font-weight:700">
              <span class="h-2 w-2 shrink-0 rounded-full bg-brand"></span>
              {i}
            </span>
          ))}
        </div>
      </div>
      {/* La segunda fila solo en pantallas grandes: en mobile alcanza con una y ahorra scroll */}
      <div class="marquee hidden sm:block">
        <div class="marquee__track marquee__track--reverse">
          {[...[...INDUSTRIES].reverse(), ...[...INDUSTRIES].reverse()].map((i) => (
            <span class="mx-6 flex items-center gap-3 whitespace-nowrap font-display text-xl text-ink/85 sm:text-2xl" style="font-weight:700">
              <span class="h-2 w-2 shrink-0 rounded-full bg-brand"></span>
              {i}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FRASE DE MARCA (banda cinematográfica) -->
  <Manifesto
    pre="Sus ojos donde usted"
    accent="no ve."
    image="/img/campo-ovejas.jpg"
    objectPos="50% 80%"
    veil="soft"
  />

  <!-- DIAGNÓSTICO EXPRESS (simulador interactivo -> WhatsApp prellenado) -->
  <Diagnostico />

  <!-- CÓMO TRABAJAMOS (movido arriba: empezar es simple, primera charla sin costo) -->
  <Process />

  <!-- DIFERENCIALES -->
  <section>
    <div class="mx-auto max-w-6xl px-4 py-9 sm:px-6 sm:py-12 lg:py-16">
      <div class="max-w-2xl" data-reveal>
        <Kicker text="Por qué G&G" />
        <h2 class="title-clip mt-4 font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
          La trayectoria no se <em class="accent" style="font-style:italic">improvisa</em>
        </h2>
      </div>
      <div class="mt-7 grid gap-x-8 gap-y-6 sm:mt-10 sm:grid-cols-2 sm:gap-y-8" data-reveal-stagger>
        {DIFFERENTIALS.map((d) => (
          <div class="flex gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-brand/10 text-brand sm:h-12 sm:w-12">
              <Icon name={d.icon as any} class="h-5 w-5 sm:h-6 sm:w-6" />
            </span>
            <div>
              <h3 class="font-display text-base text-ink sm:text-lg" style="font-weight:700">{d.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-body sm:text-base">{d.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIOS (prueba social justo después de "Por qué G&G") -->
  <Testimonials />

  <!-- NUESTROS CLIENTES (logos en marquee continuo, estilo Cloudflare) -->
  <section class="surface-paper-soft overflow-hidden py-9 sm:py-12 lg:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6" data-reveal>
      <Kicker text="Confían en nosotros" />
      <h2 class="title-clip mt-4 max-w-2xl font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
        Nuestros <em class="accent" style="font-style:italic">clientes</em>
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-body">
        Empresas y grupos de distintos sectores que confían su día a día impositivo, contable y societario al estudio.
      </p>
    </div>

    <div class="mt-7 border-y border-line py-6 sm:mt-10 sm:py-8">
      <div class="marquee">
        <div class="marquee__track">
          {clientStrip.concat(clientStrip).map((c) => (
            <span class="client-logo mx-10 flex h-16 shrink-0 items-center whitespace-nowrap">
              {c.logo ? (
                <img src={c.logo} alt={c.name} class:list={[c.imgClass ?? 'h-10 w-auto']} loading="lazy" />
              ) : (
                <span class="font-display text-2xl tracking-tight sm:text-3xl" style="font-weight:800">{c.name}</span>
              )}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- EQUIPO (más presencia: monograma + nombre + rol) -->
  <section id="equipo" class="mesh scroll-mt-20 overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 py-9 sm:px-6 sm:py-12 lg:py-16">
      <div class="max-w-2xl" data-reveal>
        <Kicker text="El equipo" />
        <h2 class="title-clip mt-4 font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
          Tres generaciones, un mismo estudio
        </h2>
      </div>
      <div class="mt-7 grid items-start gap-4 sm:mt-10 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3" data-reveal-stagger>
        {TEAM.map((m) => (
          <details class="group lift surface-card overflow-hidden rounded-2xl">
            {/* En mobile la ficha es horizontal y compacta (foto chica a la izquierda); en sm+ vuelve a columna centrada */}
            <summary class="flex cursor-pointer list-none items-center gap-4 p-4 sm:flex-col sm:gap-0 sm:p-6 sm:text-center">
              {m.photo ? (
                <img
                  src={m.photo}
                  alt={m.name}
                  loading="lazy"
                  class="h-16 w-16 shrink-0 rounded-full object-cover ring-1 ring-line shadow-[0_8px_22px_-8px_rgba(20,23,31,0.22)] sm:h-28 sm:w-28"
                />
              ) : (
                <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-brand-bright to-brand-ink font-display text-lg text-white shadow-[0_10px_24px_-8px_rgba(205,51,51,0.75)] ring-1 ring-white/40 sm:h-28 sm:w-28 sm:text-2xl" style="font-weight:800">
                  {m.initials}
                </span>
              )}
              <span class="flex min-w-0 flex-1 flex-col sm:flex-none sm:items-center">
                <p class="font-display text-base text-ink sm:mt-4 sm:text-lg" style="font-weight:700">{m.name}</p>
                <p class="mt-0.5 text-xs font-bold uppercase tracking-[0.12em] text-brand-ink sm:mt-1">{m.role}</p>
                <span class="mt-1.5 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.1em] text-muted transition-colors group-hover:text-brand-ink sm:mt-3">
                  <span class="group-open:hidden">Ver perfil</span>
                  <span class="hidden group-open:inline">Cerrar</span>
                  <svg class="faq-chevron h-4 w-4 shrink-0 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </span>
            </summary>
            <div class="faq-answer">
              <div class="overflow-hidden">
                <p class="px-4 pb-4 text-sm leading-relaxed text-body sm:px-6 sm:pb-6">{m.bio}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
      <a href="/quienes-somos" class="underline-grow mt-8 inline-block text-sm font-semibold text-brand-ink">
        Conocé al equipo →
      </a>
    </div>
  </section>

  <!-- NOVEDADES (2 más recientes) -->
  <div class="brush-band" aria-hidden="true"></div>
  <section class="surface-paper-soft">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:py-10">
      <div class="flex flex-wrap items-end justify-between gap-3" data-reveal>
        <div>
          <Kicker text="Prensa" />
          <h2 class="mt-3 font-display text-2xl leading-tight text-brand sm:text-3xl" style="font-weight:700">
            El estudio en los <em class="accent" style="font-style:italic">medios</em>
          </h2>
        </div>
        <a href="/novedades" class="underline-grow text-sm font-semibold text-brand-ink">Ver todas →</a>
      </div>

      <ul class="mt-6 border-t border-line" data-reveal-stagger>
        {posts.map((p) => (
          <li class="border-b border-line">
            <a
              href={`/novedades/${p.id}`}
              class="group flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4"
            >
              <span class="font-display text-base leading-snug text-ink transition-colors group-hover:text-brand-ink sm:text-lg" style="font-weight:700">
                {p.data.title}
              </span>
              <span class="shrink-0 text-xs font-semibold uppercase tracking-[0.1em] text-muted">
                <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
                {p.data.source && <span class="text-brand-ink"> · {p.data.source}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ (pegada al cierre: responde objeciones antes de decidir) -->
  <Faq />

  <CtaBand />

  <script>
    // Dispara la entrada letra por letra del título del hero (estilo VEX).
    // astro:page-load corre en la carga inicial y en cada view transition.
    document.addEventListener('astro:page-load', () => {
      const h1 = document.getElementById('hero-h1');
      if (!h1) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) h1.classList.add('hero-h1-animate');
      else window.setTimeout(() => h1.classList.add('hero-h1-animate'), 200);
    });
  </script>
</Base>
