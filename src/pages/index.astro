---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Kicker from '../components/Kicker.astro';
import StatBand from '../components/StatBand.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Manifesto from '../components/Manifesto.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, waLink, TEAM, INDUSTRIES, DIFFERENTIALS, FAQ } from '../data/site';
import { fmtDate } from '../data/format';

const posts = (await getCollection('novedades'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const stats = [
  { value: 40, suffix: '+', label: 'años de trayectoria' },
  { value: 3, label: 'generaciones al frente' },
  { value: 12, suffix: '+', label: 'industrias asesoradas' },
  { text: 'BOKS', value: 0, label: 'red internacional' },
];

// JSON-LD de FAQ para SEO
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Ghirardotti & Ghirardotti | Estudio Contable e Impositivo en San Isidro"
  description={SITE.description}
  jsonLdExtra={faqJsonLd}
>
  <!-- HERO -->
  <section class="mesh masthead-top grid-paper border-b border-line bg-paper">
    <div class="mx-auto max-w-6xl px-4 pb-14 pt-14 sm:px-6 lg:grid lg:grid-cols-[1.25fr_0.75fr] lg:gap-16 lg:pb-20 lg:pt-20">
      <div>
        <div class="hero-in hero-in-1">
          <Kicker text="Est. 1984 · San Isidro · BOKS International" />
        </div>
        <h1 class="hero-in hero-in-2 font-display mt-6 text-[2.05rem] leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-6xl lg:leading-[1]" style="font-weight:800">
          Tu contabilidad y tus impuestos, atendidos por un <em class="accent is-visible">socio</em> del estudio.
        </h1>
        <p class="hero-in hero-in-3 mt-7 max-w-xl text-lg leading-[1.7] text-body">
          Hace más de 40 años protegemos la utilidad y los activos de empresas de todos los tamaños.
          Tres generaciones de contadores y abogados, con atención directa — no un mostrador.
        </p>
        <div class="hero-in hero-in-4 mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a
            href={waLink}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-md bg-wsp px-7 py-4 text-base font-bold text-white shadow-[0_12px_30px_-10px_rgba(37,211,102,0.6)] transition-colors hover:bg-wsp-dark"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Z" />
              <path d="M12.04 2C6.56 2 2.1 6.45 2.1 11.93c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.92 9.92 0 0 0 4.79 1.22h.01c5.47 0 9.93-4.45 9.93-9.93A9.86 9.86 0 0 0 12.04 2Zm0 18.16a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38 8.27 8.27 0 0 1 8.25-8.25 8.2 8.2 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.41 5.84 8.27 8.27 0 0 1-8.24 8.23Z" />
            </svg>
            Hablar con un socio
          </a>
          <a href="#servicios" class="underline-grow text-base font-semibold text-ink">Ver servicios</a>
        </div>
        <p class="hero-in hero-in-4 mt-6 text-sm text-muted">
          Miembro de BOKS International · 3 generaciones de contadores
        </p>
      </div>

      <!-- Columna derecha: imagen tratada con parallax + compromiso -->
      <div class="hero-in hero-in-5 mt-12 lg:mt-0">
        <div class="duotone relative flex aspect-[5/6] flex-col justify-end rounded-sm border border-line lg:aspect-[4/5]">
          <img
            src="/img/hero-impositivo.jpg"
            alt=""
            aria-hidden="true"
            data-parallax="0.05"
            class="absolute inset-x-0 -top-[8%] h-[116%] w-full object-cover"
          />
          <span class="absolute right-0 top-0 z-10 h-12 w-12 border-b border-l border-brand-bright"></span>
          <div class="relative z-10 p-7 sm:p-8">
            <Kicker text="El compromiso G&G" light />
            <p class="font-display mt-4 text-2xl leading-snug text-white sm:text-[1.7rem]" style="font-weight:800">
              Cada cliente trabaja directamente con un <em class="text-brand-bright" style="font-style:italic">socio</em>.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Banda de stats -->
    <div class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <StatBand stats={stats} />
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section id="servicios" class="scroll-mt-20 surface-paper-soft">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
      <div class="max-w-2xl" data-reveal>
        <Kicker text="Servicios" />
        <h2 class="mt-4 font-display text-3xl leading-tight text-ink sm:text-[2.75rem]" style="font-weight:700">
          Todo lo que tu empresa necesita, en un solo estudio
        </h2>
        <p class="mt-4 text-base leading-relaxed text-body">
          Contadores públicos y abogados trabajando juntos sobre las cinco áreas que definen la salud
          contable y fiscal de un negocio.
        </p>
      </div>

      <div class="mt-12">
        <ServiceIndex />
      </div>

      <!-- Fila destacada: no sabés por dónde empezar -->
      <div class="surface-ink mt-8 flex flex-col items-start gap-5 p-7 sm:flex-row sm:items-center sm:justify-between" data-reveal>
        <div>
          <h3 class="font-display text-xl text-white" style="font-weight:700">¿No sabés por dónde empezar?</h3>
          <p class="mt-1.5 text-sm text-white/65">Contanos tu situación y un socio te orienta hacia lo que mejor la resuelve.</p>
        </div>
        <a
          href={waLink}
          target="_blank"
          rel="noopener"
          class="inline-flex shrink-0 items-center gap-2 rounded-md bg-wsp px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-wsp-dark"
        >
          Escribinos
        </a>
      </div>
    </div>
  </section>

  <!-- MANIFIESTO -->
  <Manifesto
    pre="El asesoramiento como valor agregado, no como"
    accent="trámite."
  />

  <!-- DIFERENCIALES -->
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
      <div class="max-w-2xl" data-reveal>
        <Kicker text="Por qué G&G" />
        <h2 class="mt-4 font-display text-3xl leading-tight text-ink sm:text-4xl" style="font-weight:700">
          La trayectoria es el activo que no se puede improvisar
        </h2>
      </div>
      <div class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2" data-reveal-stagger>
        {DIFFERENTIALS.map((d, i) => (
          <div>
            <span class="block h-[2px] w-10 rule-draw bg-brand"></span>
            <div class="mt-5 flex items-baseline gap-4">
              <span class="font-display tabular text-3xl leading-none text-line-strong" style="font-weight:800">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="font-display text-xl text-ink" style="font-weight:700">{d.title}</h3>
            </div>
            <p class="mt-3 pl-[3.25rem] text-base leading-relaxed text-body">{d.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIOS -->
  <Testimonials />

  <!-- CÓMO TRABAJAMOS -->
  <Process />

  <!-- EQUIPO (teaser compacto) -->
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
      <div class="surface-card flex flex-col items-start gap-6 rounded-sm p-7 sm:flex-row sm:items-center sm:justify-between sm:p-9" data-reveal>
        <div class="flex items-center gap-5">
          <div class="flex -space-x-3">
            {TEAM.map((m) => (
              <span class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-surface bg-ink font-display text-sm text-white" style="font-weight:700">
                {m.initials}
              </span>
            ))}
          </div>
          <div>
            <p class="kicker">El equipo</p>
            <h2 class="mt-1 font-display text-xl text-ink sm:text-2xl" style="font-weight:700">
              Tres generaciones, un mismo estudio
            </h2>
          </div>
        </div>
        <a href="/quienes-somos" class="underline-grow shrink-0 text-sm font-semibold text-brand-ink">
          Conocé al equipo →
        </a>
      </div>
    </div>
  </section>

  <!-- INDUSTRIAS (marquee dinámico) -->
  <section class="surface-paper-soft overflow-hidden py-16 lg:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6" data-reveal>
      <Kicker text="Industrias" />
      <h2 class="mt-4 max-w-2xl font-display text-3xl leading-tight text-ink sm:text-4xl" style="font-weight:700">
        Conocemos tu rubro
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-body">
        Cada industria tiene sus reglas, sus riesgos y sus oportunidades fiscales. Estas son algunas
        de las que asesoramos hace años:
      </p>
    </div>

    <div class="marquee mt-12 border-y border-line py-6">
      <div class="marquee__track">
        {[...INDUSTRIES, ...INDUSTRIES].map((i) => (
          <span class="mx-6 flex items-center gap-3 whitespace-nowrap font-display text-2xl text-ink/85 sm:text-3xl" style="font-weight:700">
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-brand"></span>
            {i}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <Faq />

  <!-- NOVEDADES -->
  <section class="surface-paper-soft border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <Kicker text="Novedades" />
          <h2 class="mt-4 font-display text-3xl leading-tight text-ink sm:text-4xl" style="font-weight:700">
            El estudio en los medios
          </h2>
        </div>
        <a href="/novedades" class="underline-grow text-sm font-semibold text-brand-ink">Ver todas →</a>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-stagger>
        {posts.map((p) => (
          <a
            href={`/novedades/${p.id}`}
            class="group lift flex flex-col rounded-sm border-t-2 border-line surface-card p-7 hover:border-brand"
          >
            <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.12em] text-muted">
              <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
              {p.data.source && <span class="text-brand-ink">· {p.data.source}</span>}
            </div>
            <h3 class="mt-3 flex-1 font-display text-xl leading-snug text-ink transition-colors group-hover:text-brand-ink" style="font-weight:700">
              {p.data.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-body">{p.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
