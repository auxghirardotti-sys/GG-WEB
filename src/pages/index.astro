---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Kicker from '../components/Kicker.astro';
import StatBand from '../components/StatBand.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Diagnostico from '../components/Diagnostico.astro';
import Manifesto from '../components/Manifesto.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, waLink, waLinkFor, TEAM, INDUSTRIES, DIFFERENTIALS, FAQ } from '../data/site';
import { fmtDate } from '../data/format';
import { Image } from 'astro:assets';
import { img } from '../data/images';

const posts = (await getCollection('novedades'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const stats = [
  { value: 40, suffix: '+', label: 'años de trayectoria' },
  { value: 3, label: 'generaciones al frente' },
  { value: 12, suffix: '+', label: 'industrias asesoradas' },
  { text: 'BOKS', value: 0, label: 'red internacional' },
];

// JSON-LD de FAQ para SEO
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Ghirardotti & Ghirardotti | Estudio Contable e Impositivo en San Isidro"
  description={SITE.description}
  jsonLdExtra={faqJsonLd}
>
  <!-- HERO cinematográfico (imagen de fondo + parallax + Ken Burns) -->
  <section class="cine masthead-top">
    <div class="cine__media" data-parallax="0.12">
      <Image src={img('/img/hero-impositivo.jpg')} alt="" aria-hidden="true" widths={[640, 960, 1200]} sizes="100vw" format="webp" loading="eager" class="kenburns h-full w-full object-cover" />
    </div>
    <div class="cine__veil"></div>

    <div class="relative z-10 mx-auto max-w-6xl px-4 pb-10 pt-16 sm:px-6 lg:pb-14 lg:pt-24">
      <div class="max-w-2xl">
        <div class="hero-in hero-in-1">
          <Kicker text="Est. 1984 · San Isidro · BOKS International" light />
        </div>
        <h1 class="hero-in hero-in-2 font-display mt-6 leading-[1.05] tracking-tight text-white" style="font-weight:800; font-size: clamp(1.95rem, 6.2vw, 3.6rem)">
          Tu contabilidad y tus impuestos, atendidos por un <em class="accent is-visible">socio</em> del estudio.
        </h1>
        <p class="hero-in hero-in-3 mt-6 max-w-xl text-lg leading-[1.6] text-white/85">
          Asesoría impositiva, contable y societaria con criterio estratégico, no solo para cumplir
          vencimientos.
        </p>
        <div class="hero-in hero-in-4 mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a
            href={waLinkFor('Hola, quisiera que un socio del estudio me asesore.')}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-md bg-brand px-7 py-4 text-base font-bold text-white shadow-[0_16px_40px_-12px_rgba(205,51,51,0.7)] transition-transform hover:-translate-y-0.5"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Z" />
              <path d="M12.04 2C6.56 2 2.1 6.45 2.1 11.93c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.92 9.92 0 0 0 4.79 1.22h.01c5.47 0 9.93-4.45 9.93-9.93A9.86 9.86 0 0 0 12.04 2Zm0 18.16a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38 8.27 8.27 0 0 1 8.25-8.25 8.2 8.2 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.41 5.84 8.27 8.27 0 0 1-8.24 8.23Z" />
            </svg>
            Hablar con un socio
          </a>
          <a href="#servicios" class="inline-flex items-center rounded-md border border-white/35 px-7 py-4 text-base font-semibold text-white transition-colors hover:bg-white/10">Ver servicios</a>
        </div>
      </div>
    </div>

    <!-- Banda de stats sobre el hero oscuro -->
    <div class="relative z-10 border-t border-white/15">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <StatBand stats={stats} light />
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section id="servicios" class="scroll-mt-20 surface-paper-soft">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
      <div class="max-w-2xl" data-reveal>
        <Kicker text="Lo que hacemos" />
        <h2 class="mt-4 font-display text-3xl leading-tight text-brand sm:text-[2.75rem]" style="font-weight:700">
          Nuestros <em class="accent" style="font-style:italic">servicios</em>
        </h2>
        <p class="mt-4 text-base leading-relaxed text-body">
          Todo lo contable, impositivo y societario de tu empresa, en un solo lugar.
        </p>
      </div>

      <div class="mt-8">
        <ServiceIndex />
      </div>
    </div>
  </section>

  <!-- INDUSTRIAS (después de servicios) -->
  <section class="surface-paper-soft overflow-hidden py-12 lg:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6" data-reveal>
      <Kicker text="Tu sector" />
      <h2 class="mt-4 max-w-2xl font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
        Industrias con las que <em class="accent" style="font-style:italic">trabajamos</em>
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-body">
        Cada industria tiene sus reglas, sus riesgos y sus oportunidades fiscales. Estas son algunas
        de las que asesoramos hace años:
      </p>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-y border-line py-6">
      <div class="marquee">
        <div class="marquee__track">
          {[...INDUSTRIES, ...INDUSTRIES].map((i) => (
            <span class="mx-6 flex items-center gap-3 whitespace-nowrap font-display text-xl text-ink/85 sm:text-2xl" style="font-weight:700">
              <span class="h-2 w-2 shrink-0 rounded-full bg-brand"></span>
              {i}
            </span>
          ))}
        </div>
      </div>
      <div class="marquee">
        <div class="marquee__track marquee__track--reverse">
          {[...[...INDUSTRIES].reverse(), ...[...INDUSTRIES].reverse()].map((i) => (
            <span class="mx-6 flex items-center gap-3 whitespace-nowrap font-display text-xl text-ink/85 sm:text-2xl" style="font-weight:700">
              <span class="h-2 w-2 shrink-0 rounded-full bg-brand"></span>
              {i}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FRASE DE MARCA (banda cinematográfica) -->
  <Manifesto
    pre="La contabilidad es el arte de organizar la confusión y transformar el caos en"
    accent="claridad."
    image="/img/campo-ovejas.jpg"
    objectPos="50% 80%"
    veil="soft"
  />

  <!-- DIAGNÓSTICO EXPRESS (simulador interactivo -> WhatsApp prellenado) -->
  <Diagnostico />

  <!-- CÓMO TRABAJAMOS (movido arriba: empezar es simple, primera charla sin costo) -->
  <Process />

  <!-- DIFERENCIALES -->
  <section>
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
      <div class="max-w-2xl" data-reveal>
        <Kicker text="Por qué G&G" />
        <h2 class="mt-4 font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
          La trayectoria no se <em class="accent" style="font-style:italic">improvisa</em>
        </h2>
      </div>
      <div class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2" data-reveal-stagger>
        {DIFFERENTIALS.map((d) => (
          <div class="flex gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-brand/10 text-brand">
              <Icon name={d.icon as any} class="h-6 w-6" />
            </span>
            <div>
              <h3 class="font-display text-lg text-ink" style="font-weight:700">{d.title}</h3>
              <p class="mt-1 text-base leading-relaxed text-body">{d.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIOS (prueba social justo después de "Por qué G&G") -->
  <Testimonials />

  <!-- EQUIPO (más presencia: monograma + nombre + rol) -->
  <section id="equipo" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
      <div class="max-w-2xl" data-reveal>
        <Kicker text="El equipo" />
        <h2 class="mt-4 font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
          Tres generaciones, un mismo estudio
        </h2>
      </div>
      <div class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-2" data-reveal-stagger>
        {TEAM.map((m) => (
          <div class="flex items-center gap-4">
            <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full border-2 border-brand/30 bg-surface font-display text-lg text-brand" style="font-weight:800">
              {m.initials}
            </span>
            <div>
              <p class="font-display text-base text-ink" style="font-weight:700">{m.name}</p>
              <p class="text-sm text-muted">{m.role}</p>
            </div>
          </div>
        ))}
      </div>
      <a href="/quienes-somos" class="underline-grow mt-8 inline-block text-sm font-semibold text-brand-ink">
        Conocé al equipo →
      </a>
    </div>
  </section>

  <!-- NOVEDADES (2 más recientes) -->
  <div class="brush-band" aria-hidden="true"></div>
  <section class="surface-paper-soft">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <Kicker text="Prensa" />
          <h2 class="mt-4 font-display text-3xl leading-tight text-brand sm:text-4xl" style="font-weight:700">
            El estudio en los <em class="accent" style="font-style:italic">medios</em>
          </h2>
        </div>
        <a href="/novedades" class="underline-grow text-sm font-semibold text-brand-ink">Ver todas →</a>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2" data-reveal-stagger>
        {posts.map((p) => (
          <a
            href={`/novedades/${p.id}`}
            class="group lift flex flex-col rounded-sm border-t-2 border-line surface-card p-7 hover:border-brand"
          >
            <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.12em] text-muted">
              <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
              {p.data.source && <span class="text-brand-ink">· {p.data.source}</span>}
            </div>
            <h3 class="mt-3 flex-1 font-display text-xl leading-snug text-ink transition-colors group-hover:text-brand-ink" style="font-weight:700">
              {p.data.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-body">{p.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ (pegada al cierre: responde objeciones antes de decidir) -->
  <Faq />

  <CtaBand />
</Base>
