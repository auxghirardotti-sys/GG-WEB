---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Kicker from '../components/Kicker.astro';
import StatBand from '../components/StatBand.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Diagnostico from '../components/Diagnostico.astro';
import Manifesto from '../components/Manifesto.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import NovedadCard from '../components/NovedadCard.astro';
import { SITE, waLink, waLinkFor, TEAM, INDUSTRIES, DIFFERENTIALS, FAQ, CLIENTS } from '../data/site';
import { fmtDate } from '../data/format';
import { Image, getImage } from 'astro:assets';
import { img } from '../data/images';

// Portada: fotos de la Catedral de San Isidro (ancla geográfica del estudio).
// Mobile = foto PROPIA del estudio desde la Plaza Mitre (960x1280, sin licencia
// de terceros); desktop = lateral con la plaza y la estatua (dominio público).
// Para cambiar la de escritorio por la versión nítida: 'catedral-lateral-hd.jpg'.
const heroMobile = await getImage({
  src: img('catedral-plaza.jpg'),
  // width fija el src de respaldo. Tope en 820px: el hero mide 375 CSS, así que a
  // densidad 2x alcanza de sobra, y el ramaje fino de la foto compone muy pesado más arriba.
  width: 640,
  widths: [400, 560, 820],
  format: 'webp',
  quality: 70,
});
const heroDesktop = await getImage({
  src: img('catedral-lateral.jpg'),
  widths: [1024],
  format: 'webp',
  quality: 82,
});

// El carrusel de prensa muestra TODAS las notas recientes, no un recorte: se deslizan.
// Las tres viejas (2016, 2022 y 2023) quedan solo en /novedades — no tienen link externo
// ni foto, y como cierre de un carrusel de fotos desentonan.
const DESDE_ANIO = 2024;
const posts = (await getCollection('novedades'))
  .filter((p) => p.data.date.getFullYear() >= DESDE_ANIO)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Con muchas tarjetas, un punto por tarjeta es una hilera ilegible. Los puntos son un
// indicador de posición, no un índice: con seis alcanza. initCarouselDots() mapea el
// scroll sobre la cantidad de puntos que haya, así que no hace falta que coincidan.
const dots = Math.min(posts.length, 6);

const stats = [
  { value: 60, suffix: '+', label: 'años de trayectoria' },
  { value: 500, suffix: '+', label: 'clientes asesorados' },
];

// Título del hero animado letra por letra (estilo VEX). "auditoría" en acento rojo; el punto en blanco.
const heroWords: { ch: string; accent: boolean }[][] = [
  ...'Asesoramiento fiscal, societario, contable y'
    .split(' ')
    .map((w) => [...w].map((ch) => ({ ch, accent: false }))),
  [
    ...[...'auditoría'].map((ch) => ({ ch, accent: true })),
    { ch: '.', accent: false },
  ],
];
let heroCharIndex = 0;

// Logos de clientes repetidos para que el marquee (translate -50%) cierre sin saltos: la
// pista son dos mitades iguales y cada mitad tiene que ser mas ancha que la pantalla.
// Con 6 clientes, una tanda mide ~1400px, asi que dos tandas por mitad (24 <img> en total)
// alcanzan hasta ~2800px de ancho. Antes iban 4 tandas por mitad = 48 <img>: el doble de
// nodos y una capa de composicion de 9500px de ancho, que en Android de gama baja pesa.
const clientStrip = [...CLIENTS, ...CLIENTS];

// JSON-LD de FAQ para SEO
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Ghirardotti & Ghirardotti | Asesoramiento Fiscal, Societario, Contable y Auditoría · San Isidro"
  description={SITE.description}
  jsonLdExtra={faqJsonLd}
>
  <!-- HERO full-screen con video de fondo (look "VEX": media a sangre + liquid glass) -->
  {/* En celular el alto sigue la proporción de la foto (3:4 -> 133vw) para que entre
      completa; el min() evita un hero desmesurado en celular apaisado. */}
  {/* cine--hero marca SOLO esta portada: las reglas de celular que hacen entrar la foto
      completa no deben tocar las otras bandas .cine (Manifesto y CtaBand). */}
  <section class="cine cine--hero masthead-top relative flex min-h-[min(133vw,80svh)] flex-col sm:min-h-[92svh] lg:min-h-screen">
    <div class="cine__media sd-parallax" data-parallax="0.12">
      {/* Art direction: en celular la toma vertical de la torre; en ≥640px la lateral con la plaza.
          El navegador descarga SOLO la que corresponde a su ancho, nunca las dos. */}
      <picture>
        <source media="(min-width: 640px)" srcset={heroDesktop.srcSet.attribute} sizes="100vw" type="image/webp" />
        <img
          src={heroMobile.src}
          srcset={heroMobile.srcSet.attribute}
          sizes="100vw"
          alt="Catedral de San Isidro"
          class="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
    <!-- velo en gradiente: video crudo arriba, oscurecido abajo para legibilidad -->
    <div class="pointer-events-none absolute inset-0 z-0 bg-gradient-to-t from-black/80 via-black/35 to-transparent"></div>

    <div class="relative z-10 flex flex-1 flex-col justify-end">
      <div class="mx-auto w-full max-w-6xl px-4 pb-6 pt-20 sm:px-6 sm:pb-10 sm:pt-28 lg:pb-14">
        <div class="lg:grid lg:grid-cols-2 lg:items-end lg:gap-10">
          <div class="max-w-2xl">
        <div class="hero-in hero-in-1">
          <Kicker text="Est. 1967 · San Isidro" light />
        </div>
        <h1 id="hero-h1" class="font-display hero-legible mt-3 leading-[1.18] [word-spacing:0.12em] text-white sm:mt-6 sm:leading-[1.05] sm:[word-spacing:normal]" style="font-weight:800; font-size: clamp(1.65rem, 6.2vw, 3.6rem)">
          {heroWords.map((word, wi) => (
            <Fragment>
              {wi > 0 && ' '}
              <span class="inline-block whitespace-nowrap">
                {word.map((c) => {
                  const i = heroCharIndex++;
                  return (
                    <span class:list={['hero-char', c.accent && 'accent']} style={`animation-delay:${i * 30}ms`}>{c.ch}</span>
                  );
                })}
              </span>
            </Fragment>
          ))}
        </h1>
        <p class="hero-in hero-in-3 hero-legible mt-3 max-w-xl text-[15px] leading-[1.55] text-white sm:mt-6 sm:text-lg sm:leading-[1.6] sm:text-white/85">
          Acompañamos a empresas y grupos —locales e internacionales— con criterio estratégico, no
          solo para cumplir vencimientos.
        </p>
        <div class="hero-in hero-in-5 mt-5 flex flex-wrap items-center gap-2 sm:mt-9 sm:gap-x-7 sm:gap-y-4">
          <a
            href={waLinkFor('Hola, quisiera que un socio del estudio me asesore.')}
            target="_blank"
            rel="noopener"
            class="btn-shine inline-flex items-center gap-2 rounded-md bg-brand px-4 py-3 text-sm font-bold text-white shadow-[0_16px_40px_-12px_rgba(205,51,51,0.7)] sm:px-7 sm:py-4 sm:text-base"
            data-magnetic
          >
            <svg class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Z" />
              <path d="M12.04 2C6.56 2 2.1 6.45 2.1 11.93c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.92 9.92 0 0 0 4.79 1.22h.01c5.47 0 9.93-4.45 9.93-9.93A9.86 9.86 0 0 0 12.04 2Zm0 18.16a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38 8.27 8.27 0 0 1 8.25-8.25 8.2 8.2 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.41 5.84 8.27 8.27 0 0 1-8.24 8.23Z" />
            </svg>
            Hablar con un socio
          </a>
          <a href="#servicios" class="liquid-glass inline-flex items-center rounded-md px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-white hover:text-black sm:px-7 sm:py-4 sm:text-base">Ver servicios</a>
            </div>
          </div>

          <!-- columna derecha: tag de cristal (estilo VEX) -->
          <div class="mt-4 flex sm:mt-10 lg:mt-0 lg:justify-end">
            <div class="hero-in hero-in-4 liquid-glass max-w-sm rounded-xl px-4 py-2.5 sm:px-6 sm:py-4">
              <div class="flex items-center gap-2.5">
                <span class="text-brand-bright"><Icon name="globe" class="h-4 w-4 sm:h-5 sm:w-5" /></span>
                <span class="font-display text-sm text-white sm:text-base" style="font-weight:700">Miembro de BOKS International</span>
              </div>
              <p class="mt-1 hidden text-sm leading-relaxed text-white/70 sm:block">Red global de firmas legales y contables</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Banda de stats sobre el hero -->
      <div class="relative z-10 border-t border-white/15">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <StatBand stats={stats} light />
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section id="servicios" class="scroll-mt-20 surface-paper-soft">
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:pt-12 sm:pb-8 lg:pt-16 lg:pb-8">
      <div class="max-w-2xl" data-reveal>
        <Kicker text="Lo que hacemos" />
        <h2 class="title-clip mt-2 font-display text-2xl leading-tight text-brand sm:mt-4 sm:text-[2.75rem]" style="font-weight:700">
          Nuestros <em class="accent" style="font-style:italic">servicios</em>
        </h2>
        <p class="mt-2 hidden text-[13px] leading-snug text-body sm:mt-4 sm:block sm:text-base sm:leading-relaxed">
          Asesoramiento fiscal, contable, societario y patrimonial —con especialización en el agro— para tu empresa, bajo un mismo techo.
        </p>
      </div>

      <div class="mt-5 sm:mt-8">
        <ServiceIndex />
      </div>
    </div>
  </section>

  <!-- INDUSTRIAS (después de servicios) -->
  <section class="surface-paper-soft overflow-hidden py-6 sm:py-8 lg:py-8">
    <div class="mx-auto max-w-6xl px-4 sm:px-6" data-reveal>
      <Kicker text="Tu sector" />
      <h2 class="title-clip mt-2 max-w-2xl font-display text-2xl leading-tight text-brand sm:mt-4 sm:text-4xl" style="font-weight:700">
        Industrias con las que <em class="accent" style="font-style:italic">trabajamos</em>
      </h2>
      <p class="mt-2 hidden max-w-2xl text-[13px] leading-snug text-body sm:mt-4 sm:block sm:text-base sm:leading-relaxed">
        No es lo mismo asesorar a un campo que a una desarrolladora o a un estudio de abogados.
        Conocemos de adentro estos sectores:
      </p>
    </div>

    <div class="mt-4 flex flex-col gap-4 border-y border-line py-3 sm:mt-6 sm:py-4">
      <div class="marquee">
        <div class="marquee__track">
          {[...INDUSTRIES, ...INDUSTRIES].map((i) => (
            <span class="mx-4 flex items-center gap-2.5 whitespace-nowrap font-display text-base text-ink/85 sm:mx-6 sm:gap-3 sm:text-2xl" style="font-weight:700">
              <span class="h-2 w-2 shrink-0 rounded-full bg-brand"></span>
              {i}
            </span>
          ))}
        </div>
      </div>
      {/* La segunda fila solo en pantallas grandes: en mobile alcanza con una y ahorra scroll */}
      <div class="marquee hidden sm:block">
        <div class="marquee__track marquee__track--reverse">
          {[...[...INDUSTRIES].reverse(), ...[...INDUSTRIES].reverse()].map((i) => (
            <span class="mx-6 flex items-center gap-3 whitespace-nowrap font-display text-xl text-ink/85 sm:text-2xl" style="font-weight:700">
              <span class="h-2 w-2 shrink-0 rounded-full bg-brand"></span>
              {i}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FRASE DE MARCA (banda cinematográfica) -->
  <Manifesto
    pre="Sus ojos donde usted"
    accent="no ve."
    image="/img/campo-ovejas.jpg"
    objectPos="50% 80%"
    veil="soft"
  />

  <!-- DIAGNÓSTICO EXPRESS (simulador interactivo -> WhatsApp prellenado) -->
  <Diagnostico />

  <!-- CÓMO TRABAJAMOS (movido arriba: empezar es simple, primera charla sin costo) -->
  <Process />

  <!-- DIFERENCIALES -->
  <section>
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8 lg:py-8">
      <div class="max-w-2xl" data-reveal>
        <Kicker text="Por qué G&G" />
        <h2 class="title-clip mt-2 font-display text-2xl leading-tight text-brand sm:mt-4 sm:text-4xl" style="font-weight:700">
          La trayectoria no se <em class="accent" style="font-style:italic">improvisa</em>
        </h2>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-2.5 sm:mt-10 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-8" data-reveal-stagger>
        {DIFFERENTIALS.map((d) => (
          <div class="flex flex-col rounded-2xl border border-line bg-surface p-3 sm:flex-row sm:gap-4 sm:rounded-none sm:border-0 sm:bg-transparent sm:p-0">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand sm:h-12 sm:w-12 sm:rounded-md">
              <Icon name={d.icon as any} class="h-5 w-5 sm:h-6 sm:w-6" />
            </span>
            <div>
              <h3 class="mt-2 font-display text-[13px] leading-tight text-ink sm:mt-0 sm:text-lg sm:leading-7" style="font-weight:700">{d.title}</h3>
              <p class="mt-1 hidden text-sm leading-relaxed text-body sm:block sm:text-base">{d.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIOS (prueba social justo después de "Por qué G&G") -->
  <Testimonials />

  <!-- NUESTROS CLIENTES (logos en marquee continuo, estilo Cloudflare) -->
  <section class="surface-paper-soft overflow-hidden py-6 sm:py-8 lg:py-8">
    <div class="mx-auto max-w-6xl px-4 sm:px-6" data-reveal>
      <Kicker text="Confían en nosotros" />
      <h2 class="title-clip mt-2 max-w-2xl font-display text-2xl leading-tight text-brand sm:mt-4 sm:text-4xl" style="font-weight:700">
        Nuestros <em class="accent" style="font-style:italic">clientes</em>
      </h2>
      <p class="mt-2 hidden max-w-2xl text-[13px] leading-snug text-body sm:mt-4 sm:block sm:text-base sm:leading-relaxed">
        Empresas y grupos de distintos sectores que confían su día a día impositivo, contable y societario al estudio.
      </p>
    </div>

    <div class="mt-4 border-y border-line py-4 sm:mt-6 sm:py-5">
      <div class="marquee">
        <div class="marquee__track marquee__track--fast">
          {clientStrip.concat(clientStrip).map((c) => (
            <span class="client-logo mx-6 flex h-14 shrink-0 items-center whitespace-nowrap sm:mx-10 sm:h-16">
              {c.logo ? (
                <img src={c.logo} alt={c.name} class:list={[c.imgClass ?? 'h-10 w-auto']} loading="eager" decoding="async" />
              ) : (
                <span class="font-display text-xl tracking-tight sm:text-3xl" style="font-weight:800">{c.name}</span>
              )}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- EQUIPO (más presencia: monograma + nombre + rol) -->
  <section id="equipo" class="mesh scroll-mt-20 overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8 lg:py-8">
      <div class="max-w-2xl" data-reveal>
        <Kicker text="El equipo" />
        <h2 class="title-clip mt-2 font-display text-2xl leading-tight text-brand sm:mt-4 sm:text-4xl" style="font-weight:700">
          Tres generaciones, un mismo estudio
        </h2>
      </div>
      <div class="mt-4 grid items-start gap-2.5 sm:mt-10 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3" data-reveal-stagger>
        {TEAM.map((m) => (
          <details class="group lift surface-card overflow-hidden rounded-2xl">
            {/* En mobile la ficha es horizontal y compacta (foto chica a la izquierda); en sm+ vuelve a columna centrada */}
            <summary class="flex cursor-pointer list-none items-center gap-3 p-3 sm:flex-col sm:gap-0 sm:p-6 sm:text-center">
              {m.photo ? (
                <img
                  src={m.photo}
                  alt={m.name}
                  loading="lazy"
                  class="h-14 w-14 shrink-0 rounded-full object-cover ring-1 ring-line shadow-[0_8px_22px_-8px_rgba(20,23,31,0.22)] sm:h-28 sm:w-28"
                />
              ) : (
                <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-brand-bright to-brand-ink font-display text-base text-white shadow-[0_10px_24px_-8px_rgba(205,51,51,0.75)] ring-1 ring-white/40 sm:h-28 sm:w-28 sm:text-2xl" style="font-weight:800">
                  {m.initials}
                </span>
              )}
              <span class="flex min-w-0 flex-1 flex-col sm:flex-none sm:items-center">
                <p class="font-display text-[15px] text-ink sm:mt-4 sm:text-lg" style="font-weight:700">{m.name}</p>
                <p class="mt-0.5 text-xs font-bold uppercase tracking-[0.12em] text-brand-ink sm:mt-1">{m.role}</p>
                <span class="mt-1 inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-[0.1em] text-muted transition-colors group-hover:text-brand-ink sm:mt-3 sm:gap-1.5 sm:text-xs">
                  <span class="group-open:hidden">Ver perfil</span>
                  <span class="hidden group-open:inline">Cerrar</span>
                  <svg class="faq-chevron h-4 w-4 shrink-0 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </span>
            </summary>
            <div class="faq-answer">
              <div class="overflow-hidden">
                <p class="px-3 pb-3 text-[13px] leading-snug text-body sm:px-6 sm:pb-6 sm:text-sm sm:leading-relaxed">{m.bio}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
      <a href="/quienes-somos" class="underline-grow mt-5 inline-block text-sm font-semibold text-brand-ink sm:mt-8">
        Conocé al equipo →
      </a>
    </div>
  </section>

  <!-- NOVEDADES (2 más recientes) -->
  <div class="brush-band" aria-hidden="true"></div>
  <section class="surface-paper-soft">
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8 lg:py-8">
      <div class="flex flex-wrap items-end justify-between gap-3" data-reveal>
        <div>
          <Kicker text="Prensa" />
          <h2 class="mt-2 font-display text-2xl leading-tight text-brand sm:mt-3 sm:text-3xl" style="font-weight:700">
            El estudio en los <em class="accent" style="font-style:italic">medios</em>
          </h2>
        </div>
        <a href="/novedades" class="underline-grow text-[13px] font-semibold text-brand-ink sm:text-sm">Ver todas →</a>
      </div>

      <div class="mt-4 sm:mt-6" data-carousel>
        <div class="no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto pb-3" data-carousel-track data-reveal-stagger>
          {posts.map((p) => <NovedadCard post={p} />)}
        </div>
        <div class="mt-3 flex justify-center gap-2 sm:mt-5">
          {Array.from({ length: dots }).map(() => (
            <span data-carousel-dot class="h-2 w-2 rounded-full bg-line transition-colors"></span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ (pegada al cierre: responde objeciones antes de decidir) -->
  <Faq />

  <CtaBand />

</Base>
