---
import Base from '../layouts/Base.astro';
import Kicker from '../components/Kicker.astro';
import TeamCard from '../components/TeamCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { TEAM } from '../data/site';
import { Image } from 'astro:assets';
import { img } from '../data/images';
---

<Base
  title="Quiénes Somos | Ghirardotti & Ghirardotti"
  description="Más de 60 años de trayectoria y tres generaciones de historia familiar. Conocé la historia y el equipo de Ghirardotti & Ghirardotti."
>
  <!-- HERO -->
  <section class="masthead-top grid-paper border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12 lg:py-14" data-reveal>
      <Kicker text="Quiénes somos" />
      <h1 class="font-display mt-5 max-w-4xl text-3xl leading-[1.05] text-brand sm:text-[2.5rem] lg:text-[3rem]" style="font-weight:800">
        Tres generaciones cuidando los números de las empresas
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-snug text-body sm:mt-5 sm:text-base sm:leading-relaxed lg:text-lg">
        Una compañía que, con un enfoque propio, moderno y eficiente, y con el importante aporte de su
        cuerpo de asociados, brinda soluciones empresarias en un entorno cada vez más complejo.
      </p>
    </div>
  </section>

  <!-- HISTORIA + MISIÓN -->
  <section>
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-6 sm:gap-10 sm:px-6 sm:py-12 lg:grid-cols-2 lg:py-16">
      <div data-reveal="left">
        <Kicker text="Nuestra historia" />
        <h2 class="mt-2 font-display text-2xl leading-tight text-brand sm:mt-3 sm:text-[1.75rem] lg:text-3xl" style="font-weight:700">Sesenta años de criterio</h2>
        <p class="mt-3 text-[13px] leading-snug text-body sm:mt-4 sm:text-base sm:leading-relaxed">
          El estudio nació en 1967 de la mano del Dr. Armando Ghirardotti, y creció
          junto a sus clientes: empresas que necesitaban algo más que el cumplimiento de formalidades
          administrativas. Hoy la segunda generación dirige el estudio, combinando esa trayectoria
          con un enfoque moderno y eficiente.
        </p>
        <p class="mt-3 text-[13px] leading-snug text-body sm:mt-4 sm:text-base sm:leading-relaxed">
          Quienes trabajan con nosotros buscan el asesoramiento como valor agregado distintivo: una
          mirada profesional que anticipa problemas, planifica y propone, en lugar de limitarse a
          presentar papeles a tiempo.
        </p>
      </div>
      <div class="surface-ink masthead-top flex flex-col justify-center p-5 sm:p-8 lg:p-10" data-reveal="right">
        <Kicker text="Nuestra misión" light />
        <blockquote class="mt-4 font-display text-lg leading-[1.3] text-white sm:mt-5 sm:text-2xl lg:text-[1.75rem]" style="font-weight:800">
          Proteger y manejar con eficiencia la utilidad y los activos de las empresas, desde las
          ópticas <em class="text-brand-bright" style="font-style:italic">tributaria, societaria y de auditoría.</em>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- EQUIPO -->
  <section class="surface-paper-soft">
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-12 lg:py-16">
      <div data-reveal>
        <Kicker text="El equipo" />
        <h2 class="mt-2 font-display text-2xl leading-tight text-brand sm:mt-4 sm:text-4xl" style="font-weight:700">Los socios del estudio</h2>
      </div>
      <div class="mt-5 grid gap-4 sm:mt-8 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4" data-reveal-stagger>
        {TEAM.map((m) => <TeamCard member={m} />)}
      </div>
    </div>
  </section>

  <!-- BOKS -->
  <section>
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-6 sm:gap-10 sm:px-6 sm:py-12 md:flex-row lg:py-16" data-reveal>
      <Image
        src={img('/img/boks.jpg')}
        alt="Miembro independiente de BOKS International"
        widths={[400, 768]}
        sizes="(min-width: 768px) 384px, 100vw"
        format="webp"
        class="w-full max-w-sm rounded-2xl border border-line sm:rounded-lg"
        loading="lazy"
      />
      <div>
        <Kicker text="Red internacional" />
        <h2 class="mt-2 font-display text-2xl leading-tight text-brand sm:mt-3 sm:text-[1.75rem] lg:text-3xl" style="font-weight:700">
          Alcance internacional, atención local
        </h2>
        <p class="mt-3 max-w-xl text-[13px] leading-snug text-body sm:mt-4 sm:text-base sm:leading-relaxed">
          Somos miembro independiente de <strong class="font-semibold text-ink">BOKS International</strong>,
          una red global de firmas de contadores, auditores y consultores. Eso nos permite acompañar a
          nuestros clientes en operaciones internacionales con corresponsales de confianza en decenas de
          países, sin perder la cercanía de un estudio familiar.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="¿Querés trabajar con un estudio que se involucre? Hablemos con"
    accent="un socio."
    text="Y si sos contador, abogado o estudiante avanzado y querés sumarte al equipo, escribinos: siempre buscamos talento."
  />
</Base>
