---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Kicker from '../../components/Kicker.astro';
import ServiceIndex from '../../components/ServiceIndex.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES } from '../../data/services';
import { waLinkFor } from '../../data/site';
import { Image } from 'astro:assets';
import { img } from '../../data/images';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const wa = waLinkFor(`Hola, quiero consultar por ${service.title}.`);
const [lead, ...restIntro] = service.intro;
---

<Base title={`${service.title} | Ghirardotti & Ghirardotti`} description={service.metaDescription}>
  <!-- HERO -->
  <section class="surface-ink grid-ink masthead-top relative overflow-hidden">
    {service.heroImage && (
      <Image
        src={img(service.heroImage)}
        alt=""
        aria-hidden="true"
        widths={[640, 960, 1200]}
        sizes="100vw"
        format="webp"
        class="kenburns absolute inset-0 h-full w-full object-cover opacity-[0.14] mix-blend-luminosity"
        loading="eager"
      />
    )}
    <span class="pointer-events-none absolute -right-6 top-1/2 -translate-y-1/2 select-none text-white/[0.06]" aria-hidden="true">
      <Icon name={service.icon} class="h-64 w-64 sm:h-80 sm:w-80" />
    </span>
    <div class="relative mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-14 lg:py-20">
      <nav class="text-xs font-medium uppercase tracking-[0.16em] text-white/65" aria-label="Migas de pan">
        <a href="/" class="hover:text-white">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/#servicios" class="hover:text-white">Servicios</a>
        <span class="mx-2">/</span>
        <span class="text-white/80">{service.nav}</span>
      </nav>
      <Kicker text="Servicio" light class="mt-6 is-visible" />
      <h1 class="font-display mt-4 max-w-3xl text-3xl leading-[1.05] text-white sm:text-6xl" style="font-weight:800">
        {service.heroTitle}
      </h1>
      <p class="mt-6 max-w-2xl text-sm leading-snug text-white/70 sm:text-lg sm:leading-relaxed">{service.heroSub}</p>
      <div class="mt-5 flex flex-wrap gap-3 sm:mt-9">
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-md bg-brand px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-ink sm:px-7 sm:py-3.5 sm:text-base"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Z" />
            <path d="M12.04 2C6.56 2 2.1 6.45 2.1 11.93c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.92 9.92 0 0 0 4.79 1.22h.01c5.47 0 9.93-4.45 9.93-9.93A9.86 9.86 0 0 0 12.04 2Zm0 18.16a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38 8.27 8.27 0 0 1 8.25-8.25 8.2 8.2 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.41 5.84 8.27 8.27 0 0 1-8.24 8.23Z" />
          </svg>
          Consultar por este servicio
        </a>
        <a
          href="/contacto"
          class="inline-flex items-center rounded-md border border-white/25 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10 sm:px-7 sm:py-3.5 sm:text-base"
        >
          Ir a contacto
        </a>
      </div>
    </div>
  </section>

  <!-- INTRO + ASIDE -->
  <section>
    <div class="mx-auto grid max-w-6xl gap-5 px-4 py-6 sm:gap-10 sm:px-6 sm:py-12 lg:grid-cols-[1.5fr_1fr] lg:py-16">
      <div data-reveal>
        <p class="font-display text-lg leading-[1.4] text-ink sm:text-[1.6rem]" style="font-weight:800">{lead}</p>
        {restIntro.map((p) => (
          <p class="mt-5 text-[13px] leading-snug text-body sm:text-lg sm:leading-[1.7]">{p}</p>
        ))}
      </div>
      <aside class="h-fit surface-card rounded-sm p-5 sm:p-7 lg:sticky lg:top-24" data-reveal>
        <span class="relative flex h-12 w-12 items-center justify-center bg-ink text-white">
          <span class="absolute right-0 top-0 h-4 w-4 border-b border-l border-brand-bright"></span>
          <Icon name={service.icon} class="h-6 w-6" />
        </span>
        <p class="kicker mt-5">Atención directa</p>
        <h2 class="mt-2 font-display text-xl text-ink" style="font-weight:700">
          Tu consulta la responde un socio
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-body">
          No un formulario ni un mostrador. Escribinos y contanos tu caso: te respondemos con criterio
          y sin vueltas.
        </p>
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex items-center gap-2 rounded-md bg-brand px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-ink"
        >
          WhatsApp directo
        </a>
      </aside>
    </div>
  </section>

  <!-- ITEMS -->
  <section class="surface-paper-soft">
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-12 lg:py-16">
      <div data-reveal>
        <Kicker text="Alcance" />
        <h2 class="mt-2 max-w-2xl font-display text-2xl leading-tight text-brand sm:mt-4 sm:text-4xl" style="font-weight:700">
          {service.itemsTitle}
        </h2>
      </div>
      <ul class="mt-5 grid gap-x-12 border-t border-line sm:mt-10 sm:grid-cols-2" data-reveal>
        {service.items.map((item) => (
          <li class="flex items-start gap-4 border-b border-line py-3 sm:py-5">
            <span class="mt-0.5 shrink-0 text-brand">
              <Icon name="check" class="h-5 w-5" />
            </span>
            <span class="text-sm font-medium text-ink sm:text-base">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- OTROS SERVICIOS -->
  <section>
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-12 lg:py-16">
      <div data-reveal>
        <Kicker text="Seguir explorando" />
        <h2 class="mt-2 font-display text-2xl text-brand sm:mt-4 sm:text-3xl" style="font-weight:700">
          Otros servicios del estudio
        </h2>
      </div>
      <div class="mt-5 sm:mt-10">
        <ServiceIndex exclude={service.slug} />
      </div>
    </div>
  </section>

  <CtaBand
    title="¿Querés avanzar? Hablemos con"
    accent="un socio."
    text="Contanos tu caso por WhatsApp y te decimos con franqueza cómo podemos ayudarte. Sin compromiso."
  />
</Base>
