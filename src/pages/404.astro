---
import Base from '../layouts/Base.astro';
import { waLink } from '../data/site';
---

<Base title="Página no encontrada | Ghirardotti & Ghirardotti" description="La página que buscás no existe o cambió de lugar.">
  <section class="masthead-top grid-paper border-b border-line">
    <div class="mx-auto flex min-h-[60svh] max-w-6xl flex-col items-start justify-center px-4 py-16 sm:px-6">
      <p class="font-display text-7xl leading-none text-brand sm:text-8xl" style="font-weight:800">404</p>
      <h1 class="font-display mt-6 text-2xl leading-tight text-ink sm:text-4xl" style="font-weight:700">
        Esta página no existe <em class="accent" style="font-style:italic">o cambió de lugar</em>.
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-body">
        Puede que el link esté vencido o mal escrito. Lo que buscás seguro está a un click.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn-shine inline-flex items-center gap-2 rounded-md bg-brand px-7 py-3.5 text-base font-bold text-white transition-colors hover:bg-brand-ink">
          Ir al inicio
        </a>
        <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center rounded-md border border-line-strong px-7 py-3.5 text-base font-semibold text-ink transition-colors hover:border-brand hover:text-brand-ink">
          Escribinos por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>
