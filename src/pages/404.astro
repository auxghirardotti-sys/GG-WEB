---
import Base from '../layouts/Base.astro';
import { waLink } from '../data/site';
---

<Base title="Página no encontrada | Ghirardotti & Ghirardotti" description="La página que buscás no existe o cambió de lugar.">
  <section class="masthead-top grid-paper border-b border-line">
    <div class="mx-auto flex min-h-[52svh] max-w-pagina flex-col items-start justify-center px-4 py-8 sm:px-6 sm:py-10">
      <p class="font-display text-5xl leading-none text-brand sm:text-7xl" style="font-weight:800">404</p>
      <h1 class="font-display mt-4 text-2xl leading-tight text-ink sm:mt-5 sm:text-4xl" style="font-weight:700">
        Esta página no existe <em class="accent" style="font-style:italic">o cambió de lugar</em>.
      </h1>
      <p class="mt-4 max-w-xl text-[13px] leading-snug text-body sm:text-base sm:leading-relaxed">
        Puede que el link esté vencido o mal escrito. Lo que buscás seguro está a un click.
      </p>
      <div class="mt-5 flex flex-wrap gap-3 sm:mt-8">
        <a href="/" class="btn-shine inline-flex items-center gap-2 rounded-md bg-brand px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-ink sm:px-7 sm:py-3.5 sm:text-base">
          Ir al inicio
        </a>
        <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center rounded-md border border-line-strong px-5 py-3 text-sm font-semibold text-ink transition-colors hover:border-brand hover:text-brand-ink sm:px-7 sm:py-3.5 sm:text-base">
          Escribinos por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>
