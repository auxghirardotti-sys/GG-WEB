---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { fmtDate } from '../../data/format';

export async function getStaticPaths() {
  const posts = await getCollection('novedades');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} | Novedades G&G`} description={post.data.excerpt}>
  <article class="masthead-top grid-paper bg-paper">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:py-20">
      <nav class="text-xs font-medium uppercase tracking-[0.14em] text-muted" aria-label="Migas de pan">
        <a href="/" class="hover:text-brand-ink">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/novedades" class="hover:text-brand-ink">Novedades</a>
      </nav>

      <div class="mt-6 flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-muted">
        <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
        {post.data.source && <span class="text-brand-ink">· {post.data.source}</span>}
      </div>

      <h1 class="font-display mt-4 text-3xl leading-[1.1] text-brand sm:text-5xl" style="font-weight:800">
        {post.data.title}
      </h1>

      <div
        class="mt-9 space-y-5 text-lg leading-[1.75] text-body [&_a]:font-semibold [&_a]:text-brand-ink [&_a:hover]:underline [&_strong]:font-semibold [&_strong]:text-ink"
      >
        <Content />
      </div>

      {post.data.externalUrl && (
        <a
          href={post.data.externalUrl}
          target="_blank"
          rel="noopener"
          class="mt-9 inline-flex items-center gap-2 rounded-md border border-line px-6 py-3 text-sm font-bold text-ink transition-colors hover:border-brand hover:text-brand-ink"
        >
          Leer la nota original en {post.data.source}
        </a>
      )}

      <a href="/novedades" class="mt-10 block text-sm font-bold text-brand-ink hover:underline">
        ← Volver a novedades
      </a>
    </div>
  </article>

  <CtaBand />
</Base>
