---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { fmtDate } from '../../data/format';

const posts = (await getCollection('novedades')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Novedades | Ghirardotti & Ghirardotti"
  description="Novedades del estudio Ghirardotti & Ghirardotti: columnas en medios, cursos y análisis sobre actualidad impositiva, societaria y del agro."
>
  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="text-xs font-bold uppercase tracking-widest text-brand">Novedades</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
        El estudio en los medios
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed">
        Columnas, cursos y análisis de nuestros socios sobre actualidad impositiva, societaria y del
        negocio agropecuario.
      </p>

      <div class="mt-12 space-y-5">
        {posts.map((p) => (
          <a
            href={`/novedades/${p.id}`}
            class="group block rounded-2xl border border-line bg-white p-7 transition-all hover:-translate-y-0.5 hover:border-brand/40 hover:shadow-lg"
          >
            <div class="flex flex-wrap items-center gap-3 text-xs font-semibold text-muted">
              <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
              {p.data.source && (
                <span class="rounded-full bg-brand-soft px-2.5 py-0.5 font-bold text-brand">
                  {p.data.source}
                </span>
              )}
            </div>
            <h2 class="mt-3 text-2xl font-extrabold leading-snug tracking-tight text-ink group-hover:text-brand">
              {p.data.title}
            </h2>
            <p class="mt-2 max-w-2xl text-base leading-relaxed">{p.data.excerpt}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-brand">
              Leer más
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.6L10.2 5.3a.75.75 0 1 1 1.1-1.02l5.5 5.25a.75.75 0 0 1 0 1.04l-5.5 5.25a.75.75 0 1 1-1.1-1.02l4.15-3.95H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
