---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Kicker from '../../components/Kicker.astro';
import CtaBand from '../../components/CtaBand.astro';
import { fmtDate } from '../../data/format';

const posts = (await getCollection('novedades')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Novedades | Ghirardotti & Ghirardotti"
  description="Novedades del estudio Ghirardotti & Ghirardotti: columnas en medios, cursos y análisis sobre actualidad impositiva, societaria y del agro."
>
  <section class="masthead-top grid-paper border-b border-line bg-paper">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16" data-reveal>
      <Kicker text="Novedades" />
      <h1 class="font-display mt-6 text-4xl leading-[1.05] text-brand sm:text-6xl" style="font-weight:800">
        El estudio en los medios
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-[1.7] text-body">
        Columnas, cursos y análisis de nuestros socios sobre actualidad impositiva, societaria y del
        negocio agropecuario.
      </p>
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
      <div class="border-t border-line" data-reveal-stagger>
        {
          posts.map((p) => (
            <a href={`/novedades/${p.id}`} class="group block border-b border-line py-8 transition-colors hover:bg-paper-2">
              <div class="flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-muted">
                <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
                {p.data.source && <span class="text-brand-ink">· {p.data.source}</span>}
              </div>
              <h2 class="mt-3 font-display text-2xl leading-snug text-ink transition-colors group-hover:text-brand-ink sm:text-3xl" style="font-weight:700">
                {p.data.title}
              </h2>
              <p class="mt-2 max-w-2xl text-base leading-relaxed text-body">{p.data.excerpt}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-brand-ink">
                Leer más
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.6L10.2 5.3a.75.75 0 1 1 1.1-1.02l5.5 5.25a.75.75 0 0 1 0 1.04l-5.5 5.25a.75.75 0 1 1-1.1-1.02l4.15-3.95H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
