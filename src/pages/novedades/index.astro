---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Kicker from '../../components/Kicker.astro';
import CtaBand from '../../components/CtaBand.astro';
import { fmtDate } from '../../data/format';

const posts = (await getCollection('novedades')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Novedades | Ghirardotti & Ghirardotti"
  description="Novedades del estudio Ghirardotti & Ghirardotti: columnas en medios, cursos y análisis sobre actualidad impositiva, societaria y del agro."
>
  <section class="masthead-top grid-paper border-b border-line">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12 lg:py-16" data-reveal>
      <Kicker text="Novedades" />
      <h1 class="font-display mt-6 text-3xl leading-[1.05] text-brand sm:text-6xl" style="font-weight:800">
        El estudio en los medios
      </h1>
      <p class="mt-6 max-w-2xl text-sm leading-snug text-body sm:text-lg sm:leading-[1.7]">
        Columnas, cursos y análisis de nuestros socios sobre actualidad impositiva, societaria y del
        negocio agropecuario.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-10 lg:py-14">
      <div data-carousel>
        <div class="no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto pb-3" data-carousel-track data-reveal-stagger>
          {
            posts.map((p) => (
              <a
                href={p.data.externalUrl ?? `/novedades/${p.id}`}
                target={p.data.externalUrl ? '_blank' : undefined}
                rel={p.data.externalUrl ? 'noopener' : undefined}
                class="surface-card lift group flex shrink-0 basis-[70%] snap-start flex-col rounded-lg p-5 sm:basis-[46%] lg:basis-[31.5%]"
              >
                <div class="flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-muted">
                  <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
                  {p.data.source && <span class="text-brand-ink">· {p.data.source}</span>}
                </div>
                <h2 class="mt-3 font-display text-lg leading-snug text-ink transition-colors group-hover:text-brand-ink" style="font-weight:700">
                  {p.data.title}
                </h2>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-body line-clamp-3">{p.data.excerpt}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-brand-ink">
                  Leer más
                  <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.6L10.2 5.3a.75.75 0 1 1 1.1-1.02l5.5 5.25a.75.75 0 0 1 0 1.04l-5.5 5.25a.75.75 0 1 1-1.1-1.02l4.15-3.95H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                  </svg>
                </span>
              </a>
            ))
          }
        </div>
        <div class="mt-5 flex justify-center gap-2">
          {posts.map(() => (
            <span data-carousel-dot class="h-2 w-2 rounded-full bg-line transition-colors"></span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
