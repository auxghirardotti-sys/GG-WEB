---
import { getCollection } from 'astro:content';
import NovedadCard from '../../components/NovedadCard.astro';
import Base from '../../layouts/Base.astro';
import Kicker from '../../components/Kicker.astro';
import Volver from '../../components/Volver.astro';
import CtaBand from '../../components/CtaBand.astro';

const posts = (await getCollection('novedades')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Novedades | Ghirardotti & Ghirardotti"
  description="Novedades del estudio Ghirardotti & Ghirardotti: columnas en medios, cursos y análisis sobre actualidad impositiva, societaria y del agro."
>
  <section class="masthead-top grid-paper border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:py-10" data-reveal>
      <Volver href="/" label="Volver al inicio" class="mb-5" />
      <Kicker text="Novedades" />
      <h1 class="font-display mt-5 text-3xl leading-[1.05] text-brand sm:text-[2.5rem] lg:text-[3rem]" style="font-weight:800">
        El estudio en los medios
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-snug text-body sm:mt-5 sm:text-base sm:leading-relaxed lg:text-lg">
        Columnas, cursos y análisis de nuestros socios sobre actualidad impositiva, societaria y del
        negocio agropecuario.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8 lg:py-8">
      {/* Grilla, no tira scrolleable: con 22 notas conviene barrer con la vista de
          arriba a abajo y no deslizar de a una. 1 columna en celular, 2 en tablet y 3
          en escritorio. */}
      <div class="grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3" data-reveal-stagger>
        {posts.map((p) => (
          <NovedadCard
            post={p}
            as="h2"
            showExcerpt
            ancho="w-full"
            sizes="(min-width: 1024px) 360px, (min-width: 640px) 46vw, 92vw"
          />
        ))}
      </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
